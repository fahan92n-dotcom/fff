kill15  = c30 or c45 or c60 or c90 or c120 or c150 or c180 or c210 or c240 or c300
kill30  = c45 or c60 or c90 or c120 or c150 or c180 or c210 or c240 or c300
kill45  = c60 or c90 or c120 or c150 or c180 or c210 or c240 or c300
kill60  = c90 or c120 or c150 or c180 or c210 or c240 or c300
kill90  = c120 or c150 or c180 or c210 or c240 or c300
kill120 = c150 or c180 or c210 or c240 or c300
kill150 = c180 or c210 or c240 or c300
kill180 = c210 or c240 or c300
kill210 = c240 or c300
kill240 = c300

// كل استدعاء من موقع مختلف له var مستقل.
f_wave(bool isLong, bool enabled, bool kill, bool mainCl, bool confCl, bool entCl, float smiM, float histM, float macdM, float donM, float clM, float emaM, float histC, float smiE, float donE, float rsiE, float rmaE, float kE) =>
    var bool l1 = false
    var bool l2 = false
    var bool l3 = false
    var bool l4 = false
    var bool l5 = false
    var bool l6 = false
    var bool l7 = false
    var bool l8 = false
    var bool l9 = false
    var bool rsiTouch = false
    var int crossAge = 99
    var bool wasSat = false
    var bool fired = false
    if kill or not enabled
        l1 := false
        l2 := false
        l3 := false
        l4 := false
        l5 := false
        l6 := false
        l7 := false
        l8 := false
        l9 := false
        rsiTouch := false
        crossAge := 99
        wasSat := false
        fired := false
    else
        bool satM = not na(smiM) and (isLong ? smiM <= smiOs : smiM >= smiOb)
        if mainCl
            if satM and not wasSat
                l1 := false
                l2 := false
                l3 := false
                l4 := false
                l5 := false
                l6 := false
                l7 := false
                l8 := false
                l9 := false
                rsiTouch := false
                crossAge := 99
                fired := false
            wasSat := satM
            if satM
                l1 := true
            bool macdOk = not na(histM) and not na(macdM) and (isLong ? (histM < 0 and macdM > histM) : (histM > 0 and macdM < histM))
            if l1 and macdOk
                l2 := true
            bool donOk = isLong ? donM > 0 : donM < 0
            if l2 and donOk
                l3 := true
            bool emaOk = not na(clM) and not na(emaM) and (isLong ? clM < emaM : clM > emaM)
            if l3 and emaOk
                l4 := true
        if confCl
            bool confOk = not na(histC) and (isLong ? histC > 0 : histC < 0)
            if l4 and confOk
                l5 := true
        if entCl
            bool donEok = isLong ? donE < 0 : donE > 0
            if l5 and donEok
                l6 := true
            bool smiEok = not na(smiE) and (isLong ? smiE <= smiOs : smiE >= smiOb)
            if l6 and smiEok
                l7 := true
            if l7
                if isLong and not na(rsiE) and rsiE <= rsiOs
                    rsiTouch := true
                if not isLong and not na(rsiE) and rsiE >= rsiOb
                    rsiTouch := true
                bool crossed = rsiTouch and not na(rsiE) and not na(rmaE) and not na(rsiE[1]) and not na(rmaE[1]) and (isLong ? (rsiE[1] < rmaE[1] and rsiE >= rmaE) : (rsiE[1] > rmaE[1] and rsiE <= rmaE))
                if crossed
                    l8 := true
                    crossAge := 0
                else if l8 and not l9
                    crossAge += 1
                    if crossAge > stochGap
                        l8 := false
                        crossAge := 99
            if l8 and not na(kE) and kE > stochLvl and crossAge <= stochGap
                l9 := true
    bool hit = enabled and not kill and l1 and l2 and l3 and l4 and l5 and l6 and l7 and l8 and l9 and not fired
    if hit
        fired := true
    [l1, l2, l3, l4, l5, l6, l7, l8, l9, hit]

[L15_1, L15_2, L15_3, L15_4, L15_5, L15_6, L15_7, L15_8, L15_9, hit15L] = f_wave(true,  use15 and useLong, kill15, c15, c45, c5, smi15, h15, m15, don15, cl15, ema15, h45, smi5, don5, rsi5, rma5, k5)
