[t135, cl135, h135, m135, smi135, k135, rsi135, rma135, don135, ema135] = f_req("135")
[t150, cl150, h150, m150, smi150, k150, rsi150, rma150, don150, ema150] = f_req("150")
[t180, cl180, h180, m180, smi180, k180, rsi180, rma180, don180, ema180] = f_req("180")
[t210, cl210, h210, m210, smi210, k210, rsi210, rma210, don210, ema210] = f_req("210")
[t240, cl240, h240, m240, smi240, k240, rsi240, rma240, don240, ema240] = f_req("240")
[t270, cl270, h270, m270, smi270, k270, rsi270, rma270, don270, ema270] = f_req("270")
[t300, cl300, h300, m300, smi300, k300, rsi300, rma300, don300, ema300] = f_req("300")
[t360, cl360, h360, m360, smi360, k360, rsi360, rma360, don360, ema360] = f_req("360")
[t450, cl450, h450, m450, smi450, k450, rsi450, rma450, don450, ema450] = f_req("450")
[t540, cl540, h540, m540, smi540, k540, rsi540, rma540, don540, ema540] = f_req("540")
[t630, cl630, h630, m630, smi630, k630, rsi630, rma630, don630, ema630] = f_req("630")
