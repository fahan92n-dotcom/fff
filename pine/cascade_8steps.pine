sellTag = hitD3S ? "3ي/1ي" : hitD2S ? "2ي/4س" : hitD1S ? "1ي/2س" : hit240S ? "4س/80" : hit210S ? "210/70" : hit180S ? "3س/1س" : hit150S ? "150/50" : hit120S ? "2س/40" : hit90S ? "90/30" : hit60S ? "1س/20" : hit45S ? "45/15" : "30/10"
tpBuy = f_tp_pct(buyTag)
slBuy = f_sl_pct(buyTag)
tpSel = f_tp_pct(sellTag)
slSel = f_sl_pct(sellTag)

var float longStop = na
var float longLim = na
var float shortStop = na
var float shortLim = na

if buyHit
    if exitOpp and strategy.position_size < 0
        strategy.close("Short", comment="عكس")
    if strategy.position_size <= 0
        strategy.entry("Long", strategy.long, comment="شراء " + buyTag)
        longStop := close * (1.0 - slBuy / 100.0)
        longLim := close * (1.0 + tpBuy / 100.0)

if sellHit
    if exitOpp and strategy.position_size > 0
        strategy.close("Long", comment="عكس")
    if strategy.position_size >= 0
        strategy.entry("Short", strategy.short, comment="بيع " + sellTag)
        shortStop := close * (1.0 + slSel / 100.0)
        shortLim := close * (1.0 - tpSel / 100.0)

if usePct and strategy.position_size > 0
    strategy.exit("L-Exit", from_entry="Long", stop=longStop, limit=longLim)
if usePct and strategy.position_size < 0
    strategy.exit("S-Exit", from_entry="Short", stop=shortStop, limit=shortLim)

f_mark(bool v) => v ? "1" : ""

f_row(string nm, bool s1, bool s2, bool s3, bool s4, bool s5, bool s6, bool s7, bool s8) =>
    nm + f_mark(s1) + f_mark(s2) + f_mark(s3) + f_mark(s4) + f_mark(s5) + f_mark(s6) + f_mark(s7) + f_mark(s8)

if showLbl
    if hit15L
        label.new(bar_index, low, "شراء\n15/5", style=label.style_label_up, color=color.new(color.green, 0), textcolor=color.white, size=size.tiny)
    if hit30L
        label.new(bar_index, low, "شراء\n30/10", style=label.style_label_up, color=color.new(color.green, 0), textcolor=color.white, size=size.tiny)
    if hit45L
        label.new(bar_index, low, "شراء\n45/15", style=label.style_label_up, color=color.new(color.teal, 0), textcolor=color.white, size=size.tiny)
    if hit60L
        label.new(bar_index, low, "شراء\n1س/20", style=label.style_label_up, color=color.new(color.teal, 0), textcolor=color.white, size=size.tiny)
    if hit90L
        label.new(bar_index, low, "شراء\n90/30", style=label.style_label_up, color=color.new(color.teal, 0), textcolor=color.white, size=size.tiny)
    if hit120L
        label.new(bar_index, low, "شراء\n2س/40", style=label.style_label_up, color=color.new(color.navy, 0), textcolor=color.white, size=size.tiny)
    if hit150L
        label.new(bar_index, low, "شراء\n150/50", style=label.style_label_up, color=color.new(color.navy, 0), textcolor=color.white, size=size.tiny)
    if hit180L
        label.new(bar_index, low, "شراء\n3س/1س", style=label.style_label_up, color=color.new(color.navy, 0), textcolor=color.white, size=size.tiny)
    if hit210L
        label.new(bar_index, low, "شراء\n210/70", style=label.style_label_up, color=color.new(color.navy, 0), textcolor=color.white, size=size.tiny)
    if hit240L
        label.new(bar_index, low, "شراء\n4س/80", style=label.style_label_up, color=color.new(color.navy, 0), textcolor=color.white, size=size.tiny)
    if hitD1L
        label.new(bar_index, low, "شراء\n1ي/2س", style=label.style_label_up, color=color.new(color.purple, 0), textcolor=color.white, size=size.tiny)
    if hitD2L
        label.new(bar_index, low, "شراء\n2ي/4س", style=label.style_label_up, color=color.new(color.purple, 0), textcolor=color.white, size=size.tiny)
    if hitD3L
        label.new(bar_index, low, "شراء\n3ي/1ي", style=label.style_label_up, color=color.new(color.purple, 0), textcolor=color.white, size=size.tiny)

    if hit15S
        label.new(bar_index, high, "بيع\n15/5", style=label.style_label_down, color=color.new(color.red, 0), textcolor=color.white, size=size.tiny)
    if hit30S
        label.new(bar_index, high, "بيع\n30/10", style=label.style_label_down, color=color.new(color.red, 0), textcolor=color.white, size=size.tiny)
    if hit45S
        label.new(bar_index, high, "بيع\n45/15", style=label.style_label_down, color=color.new(color.orange, 0), textcolor=color.black, size=size.tiny)
    if hit60S
        label.new(bar_index, high, "بيع\n1س/20", style=label.style_label_down, color=color.new(color.orange, 0), textcolor=color.black, size=size.tiny)
    if hit90S
        label.new(bar_index, high, "بيع\n90/30", style=label.style_label_down, color=color.new(color.orange, 0), textcolor=color.black, size=size.tiny)
    if hit120S
        label.new(bar_index, high, "بيع\n2س/40", style=label.style_label_down, color=color.new(color.maroon, 0), textcolor=color.white, size=size.tiny)
    if hit150S
        label.new(bar_index, high, "بيع\n150/50", style=label.style_label_down, color=color.new(color.maroon, 0), textcolor=color.white, size=size.tiny)
    if hit180S
        label.new(bar_index, high, "بيع\n3س/1س", style=label.style_label_down, color=color.new(color.maroon, 0), textcolor=color.white, size=size.tiny)
    if hit210S
        label.new(bar_index, high, "بيع\n210/70", style=label.style_label_down, color=color.new(color.maroon, 0), textcolor=color.white, size=size.tiny)
    if hit240S
        label.new(bar_index, high, "بيع\n4س/80", style=label.style_label_down, color=color.new(color.maroon, 0), textcolor=color.white, size=size.tiny)
    if hitD1S
        label.new(bar_index, high, "بيع\n1ي/2س", style=label.style_label_down, color=color.new(color.fuchsia, 0), textcolor=color.white, size=size.tiny)
    if hitD2S
        label.new(bar_index, high, "بيع\n2ي/4س", style=label.style_label_down, color=color.new(color.fuchsia, 0), textcolor=color.white, size=size.tiny)
    if hitD3S
        label.new(bar_index, high, "بيع\n3ي/1ي", style=label.style_label_down, color=color.new(color.fuchsia, 0), textcolor=color.white, size=size.tiny)

anySetup = set15L or set30L or set45L or set60L or set90L or set120L or set150L or set180L or set210L or set240L or setD1L or setD2L or setD3L or set15S or set30S or set45S or set60S or set90S or set120S or set150S or set180S or set210S or set240S or setD1S or setD2S or setD3S
bgcolor(showBg and anySetup ? color.new(color.gray, 92) : na)
plotshape(buyHit, title="شراء", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.tiny)
plotshape(sellHit, title="بيع", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.tiny)

var label logLbl = label.new(bar_index, high, "", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, color=color.new(#111111, 5), textcolor=color.white, size=size.small, textalign=text.align_left)

chartTooHigh = timeframe.in_seconds() > 5 * 60
ltfNa = na(dC5) or na(dC20)
var label warnLbl = label.new(bar_index, high, "", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, color=color.new(color.orange, 0), textcolor=color.black, size=size.normal, textalign=text.align_left)
if chartTooHigh or ltfNa
    label.set_xy(warnLbl, bar_index, high)
    string wtxt = chartTooHigh ? "حط الشارت على 5 دقائق أو أقل\nيفضّل الدقيقة حتى تظهر كل المداخل" : ""
    if ltfNa
        wtxt := (wtxt == "" ? "" : wtxt + "\n") + "فريم الدخول رجع na — صغّر الشارت"
    label.set_text(warnLbl, wtxt)
else
    label.set_text(warnLbl, "")

if showLog
    string txt = "Cascade | ناجحة " + str.tostring(array.get(tally, 0)) + " | فاشلة " + str.tostring(array.get(tally, 1)) + " | مفتوحة " + str.tostring(array.size(pTime)) + "\n"
    txt += "أقل من 2س ربح " + str.tostring(histWin, "#.##") + "% خسارة " + str.tostring(histLoss, "#.##") + "% | 2س–يوم ربح " + str.tostring(htfWin, "#.##") + "% خسارة " + str.tostring(htfLoss, "#.##") + "% | الشارت: 5د أو أقل\n"
    txt += f_row("30 B", L30_1, L30_2, L30_3, L30_4, L30_5, L30_6, L30_7, L30_8) + " " + f_row("S", S30_1, S30_2, S30_3, S30_4, S30_5, S30_6, S30_7, S30_8) + "\n"
    txt += f_row("45 B", L45_1, L45_2, L45_3, L45_4, L45_5, L45_6, L45_7, L45_8) + " " + f_row("S", S45_1, S45_2, S45_3, S45_4, S45_5, S45_6, S45_7, S45_8) + "\n"
    txt += f_row("1س B", L60_1, L60_2, L60_3, L60_4, L60_5, L60_6, L60_7, L60_8) + " " + f_row("S", S60_1, S60_2, S60_3, S60_4, S60_5, S60_6, S60_7, S60_8) + "\n"
    txt += f_row("90 B", L90_1, L90_2, L90_3, L90_4, L90_5, L90_6, L90_7, L90_8) + " " + f_row("S", S90_1, S90_2, S90_3, S90_4, S90_5, S90_6, S90_7, S90_8) + "\n"
    txt += f_row("2س B", L120_1, L120_2, L120_3, L120_4, L120_5, L120_6, L120_7, L120_8) + " " + f_row("S", S120_1, S120_2, S120_3, S120_4, S120_5, S120_6, S120_7, S120_8) + "\n"
    txt += f_row("150 B", L150_1, L150_2, L150_3, L150_4, L150_5, L150_6, L150_7, L150_8) + " " + f_row("S", S150_1, S150_2, S150_3, S150_4, S150_5, S150_6, S150_7, S150_8) + "\n"
    txt += f_row("3س B", L180_1, L180_2, L180_3, L180_4, L180_5, L180_6, L180_7, L180_8) + " " + f_row("S", S180_1, S180_2, S180_3, S180_4, S180_5, S180_6, S180_7, S180_8) + "\n"
    txt += f_row("210 B", L210_1, L210_2, L210_3, L210_4, L210_5, L210_6, L210_7, L210_8) + " " + f_row("S", S210_1, S210_2, S210_3, S210_4, S210_5, S210_6, S210_7, S210_8) + "\n"
    txt += f_row("4س B", L240_1, L240_2, L240_3, L240_4, L240_5, L240_6, L240_7, L240_8) + " " + f_row("S", S240_1, S240_2, S240_3, S240_4, S240_5, S240_6, S240_7, S240_8) + "\n"
    txt += f_row("1ي B", LD1_1, LD1_2, LD1_3, LD1_4, LD1_5, LD1_6, LD1_7, LD1_8) + " " + f_row("S", SD1_1, SD1_2, SD1_3, SD1_4, SD1_5, SD1_6, SD1_7, SD1_8) + "\n"
    txt += f_row("2ي B", LD2_1, LD2_2, LD2_3, LD2_4, LD2_5, LD2_6, LD2_7, LD2_8) + " " + f_row("S", SD2_1, SD2_2, SD2_3, SD2_4, SD2_5, SD2_6, SD2_7, SD2_8) + "\n"
    txt += f_row("3ي B", LD3_1, LD3_2, LD3_3, LD3_4, LD3_5, LD3_6, LD3_7, LD3_8) + " " + f_row("S", SD3_1, SD3_2, SD3_3, SD3_4, SD3_5, SD3_6, SD3_7, SD3_8)
    txt += "\nشرط 5: ROC التأكيد (خط المتوسط) >0 شراء | <0 بيع | شرط 6: تأكيد شراء 50–60 بيع 40–50 والتأكيد أعلى من الرئيس 3–10 | تسلسل: 6 ثم 7 ثم 8 | إلغاء: 30←15 · 45←30 · 1س←45 · 90←1س · 2س←90 · 150←2س · 3س←150 · 210←3س · 4س←210 · 5س←4س | 2ي←1ي · 3ي←2ي · 4ي←3ي"
    if chartTooHigh
        txt += "\nحط الشارت على 5د أو أقل حتى تظهر الأسهم"
    label.set_xy(logLbl, bar_index, high)
    label.set_text(logLbl, txt)
else
    label.set_text(logLbl, "")

f_cell(table t, int col, int row, string txt, color fg, color bg) =>
    table.cell(t, col, row, txt, text_color=fg, bgcolor=bg, text_size=size.small, text_halign=text.align_center)

var table scoreBox = table.new(position.top_left, 4, 24, bgcolor=color.new(#141414, 4), border_width=1, border_color=color.new(#555555, 0), frame_color=color.new(#777777, 25), frame_width=1)
var bool scoreMerged = false
if not scoreMerged
    table.merge_cells(scoreBox, 0, 0, 3, 0)
    table.merge_cells(scoreBox, 0, 1, 3, 1)
    table.merge_cells(scoreBox, 0, 2, 3, 2)
    scoreMerged := true

if barstate.islast
    if showScore
        int wins = array.get(tally, 0)
        int losses = array.get(tally, 1)
        color scoreFg = wins > losses ? color.lime : losses > wins ? color.red : color.silver
        color hd = color.new(#1b3a5c, 0)
        color bg = color.new(#1a1a1a, 0)
        int nHist = array.size(hTime)
        int pages = int(math.max(1, math.ceil(nHist / float(pageSize))))
        int page = math.min(scorePage, pages)
        int skip = (page - 1) * pageSize
        int nBars = bar_index + 1
        float loadedDays = (time - firstBarTime) / 86400000.0
        string loadTxt = loadedDays >= 1.0 ? ("تم تحميل " + str.tostring(loadedDays, "#.#") + " يوم") : ("تم تحميل " + str.tostring(loadedDays * 24.0, "#.#") + " ساعة")
        loadTxt += "  (" + str.tostring(nBars) + " شمعة)"
        f_cell(scoreBox, 0, 0, "نتائج الصفقات   صفحة " + str.tostring(page) + " / " + str.tostring(pages) + "   |   " + loadTxt, color.white, hd)
        f_cell(scoreBox, 0, 1, "أقل من 2س ربح " + str.tostring(histWin, "#.##") + "% خسارة " + str.tostring(histLoss, "#.##") + "%  |  2س–يوم ربح " + str.tostring(htfWin, "#.##") + "% خسارة " + str.tostring(htfLoss, "#.##") + "%", color.silver, bg)
        f_cell(scoreBox, 0, 2, "ناجحة " + str.tostring(wins) + "  |  فاشلة " + str.tostring(losses) + "  |  مفتوحة " + str.tostring(array.size(pTime)), scoreFg, bg)
        f_cell(scoreBox, 0, 3, "الصفقة", color.white, hd)
        f_cell(scoreBox, 1, 3, "النتيجة", color.white, hd)
        f_cell(scoreBox, 2, 3, "رئيس", color.white, hd)
        f_cell(scoreBox, 3, 3, "تأكيد", color.white, hd)
        for k = 0 to pageSize - 1
            int src = nHist - 1 - skip - k
            int row = 4 + k
            if src >= 0
                int side = array.get(hSide, src)
                int win = array.get(hWin, src)
                string sideAr = side == 1 ? "شراء " : "بيع "
                string resTxt = win == 1 ? "ناجحة" : "فاشلة"
                color resFg = win == 1 ? color.lime : color.red
                f_cell(scoreBox, 0, row, sideAr + array.get(hTag, src), color.white, bg)
                f_cell(scoreBox, 1, row, resTxt, resFg, bg)
                f_cell(scoreBox, 2, row, f_pair_txt(array.get(hRsiM, src), array.get(hClM, src)), color.silver, bg)
                f_cell(scoreBox, 3, row, f_pair_txt(array.get(hRsiC, src), array.get(hClC, src)), color.silver, bg)
            else
                f_cell(scoreBox, 0, row, "", color.white, bg)
                f_cell(scoreBox, 1, row, "", color.white, bg)
                f_cell(scoreBox, 2, row, "", color.white, bg)
                f_cell(scoreBox, 3, row, "", color.white, bg)
    else
        table.clear(scoreBox, 0, 0, 3, 23)

alertcondition(buyHit, title="شراء", message="Cascade شراء")
alertcondition(sellHit, title="بيع", message="Cascade بيع")
