//@version=5
// BTC MTF Pulse — استراتيجية تقاطع زخم مختلفة عن Pullback (Donchian/تشبع هرمي).
// منطق الصفقة:
//   1) فريم الاتجاه (افتراضي 4H): الإغلاق فوق/تحت EMA يحدد الاتجاه فقط.
//   2) فريم التأكيد (افتراضي 1H): MACD يجب أن يوافق الاتجاه (الخط فوق/تحت الإشارة).
//   3) فريم الرسم: SMI يغادر التشبع (±40) ثم RSI يقطع متوسطه في نفس الاتجاه.
// الصق الكود في Pine Editor على BTC، فريم موصى به 15m أو 5m، ثم Add to chart.
strategy("BTC MTF Pulse",
     overlay              = true,
     pyramiding           = 0,
     initial_capital      = 10000,
     default_qty_type     = strategy.percent_of_equity,
     default_qty_value    = 10,
     commission_type      = strategy.commission.percent,
     commission_value     = 0.04,
     process_orders_on_close = true,
     max_bars_back        = 500)

// ── مدخلات الفريمات ──────────────────────────────────────────
grpTf   = "الفريمات"
htf     = input.timeframe("240", "فريم الاتجاه (HTF)", group=grpTf, tooltip="4H افتراضي — يحدد اتجاه EMA فقط")
mtf     = input.timeframe("60",  "فريم تأكيد MACD",    group=grpTf, tooltip="1H افتراضي")
useCfm  = input.bool(true, "استخدم شموع HTF/MTF المؤكدة فقط", group=grpTf, tooltip="يقلل إعادة الرسم (repaint)")

// ── SMI ──────────────────────────────────────────────────────
grpSmi  = "SMI"
smiK    = input.int(10, "SMI K", minval=1, group=grpSmi)
smiD    = input.int(3,  "SMI D (EMA مزدوج)", minval=1, group=grpSmi)
ob      = input.float(40,  "تشبع شرائي", group=grpSmi)
os      = input.float(-40, "تشبع بيعي",  group=grpSmi)
smiLook = input.int(8, "أقصى شموع بعد مغادرة التشبع", minval=1, maxval=50, group=grpSmi)

// ── MACD ─────────────────────────────────────────────────────
grpMacd = "MACD"
macdF   = input.int(12, "MACD Fast", minval=1, group=grpMacd)
macdS   = input.int(26, "MACD Slow", minval=1, group=grpMacd)
macdG   = input.int(9,  "MACD Sig",  minval=1, group=grpMacd)

// ── RSI ──────────────────────────────────────────────────────
grpRsi  = "RSI"
rsiLen  = input.int(14, "RSI Len",     minval=1, group=grpRsi)
rsiMaLn = input.int(14, "RSI SMA Len", minval=1, group=grpRsi)

// ── الاتجاه ──────────────────────────────────────────────────
grpEma  = "الاتجاه"
emaLen  = input.int(60, "EMA الاتجاه", minval=1, group=grpEma)

// ── المخاطرة ─────────────────────────────────────────────────
grpRisk = "المخاطرة"
useLong = input.bool(true,  "تفعيل الشراء", group=grpRisk)
useShrt = input.bool(true,  "تفعيل البيع",  group=grpRisk)
slMult  = input.float(1.5, "وقف ATR", minval=0.1, step=0.1, group=grpRisk)
tpMult  = input.float(2.5, "هدف ATR", minval=0.1, step=0.1, group=grpRisk)
atrLen  = input.int(14, "ATR Len", minval=1, group=grpRisk)
exitOpp = input.bool(true, "أغلق عند إشارة عكسية", group=grpRisk)

// ── دوال ─────────────────────────────────────────────────────
f_smi() =>
    ll      = ta.lowest(low, smiK)
    hh      = ta.highest(high, smiK)
    diff    = hh - ll
    rdiff   = close - (hh + ll) / 2.0
    avgrel  = ta.ema(ta.ema(rdiff, smiD), smiD)
    avgdiff = ta.ema(ta.ema(diff, smiD), smiD)
    avgdiff != 0 ? (avgrel / (avgdiff / 2.0)) * 100.0 : 0.0

f_macd_bull() =>
    [m, s, _] = ta.macd(close, macdF, macdS, macdG)
    m > s

f_macd_bear() =>
    [m, s, _] = ta.macd(close, macdF, macdS, macdG)
    m < s

f_ema() =>
    ta.ema(close, emaLen)

// ── قيم الفريمات ─────────────────────────────────────────────
// request.security يجب أن يستقبل الدالة مباشرة حتى تُحسب على الفريم المطلوب.
smiNow      = f_smi()
rsiNow      = ta.rsi(close, rsiLen)
rsiMa       = ta.sma(rsiNow, rsiMaLn)
atrNow      = ta.atr(atrLen)

htfClose    = request.security(syminfo.tickerid, htf, useCfm ? close[1] : close, lookahead=barmerge.lookahead_off)
htfEma      = request.security(syminfo.tickerid, htf, useCfm ? f_ema()[1] : f_ema(), lookahead=barmerge.lookahead_off)
mtfMacdBull = request.security(syminfo.tickerid, mtf, useCfm ? f_macd_bull()[1] : f_macd_bull(), lookahead=barmerge.lookahead_off)
mtfMacdBear = request.security(syminfo.tickerid, mtf, useCfm ? f_macd_bear()[1] : f_macd_bear(), lookahead=barmerge.lookahead_off)

htfUp       = htfClose > htfEma
htfDn       = htfClose < htfEma

leftOs      = ta.crossover(smiNow, os)
leftOb      = ta.crossunder(smiNow, ob)
barsFromOs  = ta.barssince(leftOs)
barsFromOb  = ta.barssince(leftOb)
osRecent    = not na(barsFromOs) and barsFromOs <= smiLook
obRecent    = not na(barsFromOb) and barsFromOb <= smiLook

rsiUp       = ta.crossover(rsiNow, rsiMa)
rsiDn       = ta.crossunder(rsiNow, rsiMa)

longCond    = useLong and htfUp and mtfMacdBull and osRecent and rsiUp and smiNow > os
shortCond   = useShrt and htfDn and mtfMacdBear and obRecent and rsiDn and smiNow < ob

// ── أوامر ────────────────────────────────────────────────────
var float longSl  = na
var float longTp  = na
var float shortSl = na
var float shortTp = na

if longCond
    if exitOpp and strategy.position_size < 0
        strategy.close("Short", comment="عكس→شراء")
    if strategy.position_size <= 0
        strategy.entry("Long", strategy.long, comment="Pulse شراء")
        longSl := close - atrNow * slMult
        longTp := close + atrNow * tpMult

if shortCond
    if exitOpp and strategy.position_size > 0
        strategy.close("Long", comment="عكس→بيع")
    if strategy.position_size >= 0
        strategy.entry("Short", strategy.short, comment="Pulse بيع")
        shortSl := close + atrNow * slMult
        shortTp := close - atrNow * tpMult

if strategy.position_size > 0
    strategy.exit("L-Exit", from_entry="Long", stop=longSl, limit=longTp)
if strategy.position_size < 0
    strategy.exit("S-Exit", from_entry="Short", stop=shortSl, limit=shortTp)

// ── رسم ──────────────────────────────────────────────────────
plot(htfEma, "EMA الاتجاه (HTF)", color=color.new(color.orange, 0), linewidth=2)
bgcolor(htfUp ? color.new(color.teal, 92) : htfDn ? color.new(color.maroon, 92) : na)

plotshape(longCond,  title="شراء", style=shape.triangleup,   location=location.belowbar, color=color.new(color.lime, 0),   size=size.small, text="شراء")
plotshape(shortCond, title="بيع",  style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0),    size=size.small, text="بيع")

// ── لوحة حالة ────────────────────────────────────────────────
var table dash = table.new(position.top_right, 2, 5, bgcolor=color.new(color.black, 25), border_width=1)
if barstate.islast
    table.cell(dash, 0, 0, "المؤشر",     text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 0, "الحالة",     text_color=color.gray, text_size=size.small)
    table.cell(dash, 0, 1, "اتجاه " + htf, text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 1, htfUp ? "صاعد" : htfDn ? "هابط" : "محايد", text_color=htfUp ? color.lime : htfDn ? color.red : color.gray, text_size=size.small)
    table.cell(dash, 0, 2, "MACD " + mtf, text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 2, mtfMacdBull ? "صاعد" : mtfMacdBear ? "هابط" : "—", text_color=mtfMacdBull ? color.lime : mtfMacdBear ? color.red : color.gray, text_size=size.small)
    table.cell(dash, 0, 3, "SMI الرسم",  text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 3, str.tostring(smiNow, "#.0"), text_color=smiNow >= ob ? color.red : smiNow <= os ? color.lime : color.white, text_size=size.small)
    table.cell(dash, 0, 4, "RSI / SMA",  text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 4, str.tostring(rsiNow, "#.0") + " / " + str.tostring(rsiMa, "#.0"), text_color=rsiNow > rsiMa ? color.lime : color.red, text_size=size.small)

// ── تنبيهات ──────────────────────────────────────────────────
alertcondition(longCond,  title="Pulse شراء", message="BTC MTF Pulse: إشارة شراء")
alertcondition(shortCond, title="Pulse بيع",  message="BTC MTF Pulse: إشارة بيع")
