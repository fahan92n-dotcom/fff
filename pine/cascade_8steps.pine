    if hit240L
        label.new(bar_index, low, "شراء 4س/80", style=label.style_label_up, color=color.purple, textcolor=color.white, size=size.tiny)
    if hit15S
        label.new(bar_index, high, "بيع 15/5", style=label.style_label_down, color=color.red, textcolor=color.white, size=size.tiny)
    if hit30S
        label.new(bar_index, high, "بيع 30/10", style=label.style_label_down, color=color.red, textcolor=color.white, size=size.tiny)
    if hit45S
        label.new(bar_index, high, "بيع 45/15", style=label.style_label_down, color=color.maroon, textcolor=color.white, size=size.tiny)
    if hit60S
        label.new(bar_index, high, "بيع 1س/20", style=label.style_label_down, color=color.maroon, textcolor=color.white, size=size.tiny)
    if hit90S
        label.new(bar_index, high, "بيع 90/30", style=label.style_label_down, color=color.maroon, textcolor=color.white, size=size.tiny)
    if hit120S
