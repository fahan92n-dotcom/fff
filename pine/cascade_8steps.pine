//@version=5
// Cascade 8 خطوات — الـ13 زوج يشتغلون معًا ما لم تعطّل زوج من الإعدادات.
// الشارت 5 دقائق حتى تكتمل مداخل 5م. زوج الساعة = 60/180/20 وليس شارت 1س.
// زوج الساعة = 60/180/20 (تشبع على 60م، تأكيد 180م، دخول 20م) وليس «حط الشارت على ساعة».
// request.security على فريم أدنى ترجع آخر شمعة فقط (مو كل na). security_lower_tf لا تُستخدم: حد 40 طلب + تفشل إذا الشارت أصغر.
// step7 على فريم الدخول (ثلث الأساسي): Donchian أحمر للشراء | أخضر للبيع.
// step8 على فريم الدخول: تشبع SMI → لمس RSI≤35 / ≥65 → تقاطع RSI مع متوسطه → Stoch>20 / <80 خلال 3 شموع. المفتوحة ما تُحسب.
// MACD الأساسي: شراء خط أزرق فوق الهستوجرام الأحمر | بيع خط أزرق تحت الهستوجرام الأخضر. MACD التأكيد: hist >0 شراء / <0 بيع.
// RSI تأكيد: شراء ممنوع إذا >=70 خلال آخر 30 مقفلة | بيع ممنوع إذا <=30. المفتوحة ما تُحسب.
// بدون Awesome Oscillator.
// بدون Braid Filter.
// Donchian: أساسي أخضر شراء / أحمر بيع. تأكيد نفس الاتجاه. دخول عكس الاتجاه (أحمر شراء).
// تنبيه تلقرام: أنشئ Alert → Any alert() function call → Webhook /tv?token=SECRET
// الويبهوك صامت. اطلب العدد من تلقرام بأمر /نتائج أو /score متى ما تبي.
// بعد الدخول تتحل الصفقة بربح histWin% أو خسارة histLoss%.
// الفريم الأكبر التالي: تشبع SMI (إغلاق مؤكد أو الشمعة الحالية أو أول/ثاني بعد التشبع) يمنع دخول الأصغر حتى لو الأكبر ما دخل.
// جدول أسفل الشارت يعرض ناجحة/فاشلة/مفتوحة لكل الـ13 فريم. اللوحة الرسمية لاختبار الاستراتيجية لا تقبل صفوف مخصّصة.
strategy("Cascade 8 — 13 زوج دفعة واحدة",
     overlay                  = true,
     pyramiding               = 13,
     initial_capital          = 100000,
     currency                 = currency.USD,
     default_qty_type         = strategy.percent_of_equity,
     default_qty_value        = 5,
     commission_type          = strategy.commission.percent,
     commission_value         = 0.04,
     process_orders_on_close  = true,
     calc_on_every_tick       = false,
     max_labels_count         = 500,
     max_bars_back            = 1000)

grpInd = "المؤشرات"
smiK   = input.int(10, "SMI K", minval=1, group=grpInd)
smiD   = input.int(3,  "SMI D", minval=1, group=grpInd)
osLvl  = input.float(-40, "تشبع بيعي SMI", group=grpInd)
obLvl  = input.float(40,  "تشبع شرائي SMI", group=grpInd)
macdF  = input.int(12, "MACD Fast", minval=1, group=grpInd)
macdS  = input.int(26, "MACD Slow", minval=1, group=grpInd)
macdG  = input.int(9,  "MACD Sig",  minval=1, group=grpInd)
dlen   = input.int(20, "Donchian Length", minval=2, group=grpInd)
emaLen = input.int(60, "EMA 60", minval=1, group=grpInd)
rsiLen = input.int(14, "RSI", minval=2, group=grpInd)
stKlen = input.int(15, "Stoch K", minval=1, group=grpInd)
stKsm  = input.int(3,  "Stoch K Smooth", minval=1, group=grpInd)
rsiOs  = input.float(35, "لمس RSI دخول شراء <= (إغلاق أثناء التشبع)", group=grpInd)
rsiOb  = input.float(65, "لمس RSI دخول بيع >= (إغلاق أثناء التشبع)", group=grpInd)
rsiConfOs = input.float(30, "RSI تأكيد/أساسي بيع ممنوع <= (آخر 30 مقفلة)", group=grpInd)
rsiConfOb = input.float(70, "RSI تأكيد/أساسي شراء ممنوع >= (آخر 30 مقفلة)", group=grpInd)
rsiLook   = input.int(30, "RSI شموع التأكيد والأساسي", minval=1, group=grpInd)
stochBuy  = input.float(20, "Stoch شراء >", group=grpInd)
stochSell = input.float(80, "Stoch بيع <", group=grpInd)
stochGap  = input.int(3, "Stoch بعد التقاطع", minval=0, group=grpInd)

grpP = "الأزواج — عطّل اللي ما تبيه"
use15  = input.bool(true, "15 / 45 / 5", group=grpP)
use18  = input.bool(true, "18 / 54 / 6", group=grpP)
use21  = input.bool(true, "21 / 63 / 7", group=grpP)
use24  = input.bool(true, "24 / 72 / 8", group=grpP)
use27  = input.bool(true, "27 / 81 / 9", group=grpP)
use30  = input.bool(true, "30 / 90 / 10", group=grpP)
use45  = input.bool(true, "45 / 135 / 15", group=grpP)
use60  = input.bool(true, "60 / 180 / 20", group=grpP)
use90  = input.bool(true, "90 / 270 / 30", group=grpP)
use120 = input.bool(true, "120 / 360 / 40", group=grpP)
use150 = input.bool(true, "150 / 450 / 50", group=grpP)
use210 = input.bool(true, "210 / 630 / 70", group=grpP)
use240 = input.bool(true, "240 / 720 / 80", group=grpP)

grpRisk = "إغلاق"
useLong = input.bool(true, "شراء", group=grpRisk)
useShrt = input.bool(true, "بيع", group=grpRisk)
usePct  = input.bool(true, "وقف/هدف %", group=grpRisk)
exitOpp = input.bool(true, "إغلاق عكسي", group=grpRisk)

grpVis = "العرض"
showBg  = input.bool(true, "تظليل", group=grpVis)
showLog = input.bool(true, "لوحة كل الفريمات", group=grpVis)
showLbl = input.bool(true, "ملصقات الدخول", group=grpVis)
showScore = input.bool(true, "عدد الناجحة/الفاشلة", group=grpVis)
histWin  = input.float(0.67, "ربح الصفقة %", step=0.01, group=grpVis)
histLoss = input.float(0.53, "خسارة الصفقة %", step=0.01, group=grpVis)

var array<int>    pTime = array.new_int()
var array<float>  pPx   = array.new_float()
var array<int>    pSide = array.new_int()
var array<string> pTag  = array.new_string()
var array<int>    hTime = array.new_int()
var array<string> hTag  = array.new_string()
var array<int>    hSide = array.new_int()
var array<int>    hWin  = array.new_int()
var array<int>    tally = array.new_int(2, 0)
var array<int>    tfW   = array.new_int(13, 0)
var array<int>    tfL   = array.new_int(13, 0)
var array<int>    tfO   = array.new_int(13, 0)
var array<int>    tfMW  = array.new_int(13, 0)
var array<int>    tfML  = array.new_int(13, 0)
var array<int>    mTally = array.new_int(2, 0)
var array<int>    casN  = array.new_int(1, 0)
var array<int>    fTime = array.new_int()
var array<string> fTag  = array.new_string()
var array<int>    fSide = array.new_int()

f_in_window(int ts) =>
    not na(ts) and ts >= timenow - 90 * 24 * 60 * 60 * 1000

f_tag_i(string tag) =>
    tag == "15/5" ? 0 : tag == "18/6" ? 1 : tag == "21/7" ? 2 : tag == "24/8" ? 3 : tag == "27/9" ? 4 : tag == "30/10" ? 5 : tag == "45/15" ? 6 : tag == "60/20" ? 7 : tag == "90/30" ? 8 : tag == "120/40" ? 9 : tag == "150/50" ? 10 : tag == "210/70" ? 11 : 12

f_month_open() =>
    int n = 0
    int sz = array.size(pTime)
    if sz > 0
        for i = 0 to sz - 1
            if f_in_window(array.get(pTime, i))
                n += 1
    n

f_month_tf_open(int idx) =>
    int n = 0
    int sz = array.size(pTime)
    if sz > 0
        for i = 0 to sz - 1
            if f_in_window(array.get(pTime, i)) and f_tag_i(array.get(pTag, i)) == idx
                n += 1
    n

f_fail_txt() =>
    string s = "تواريخ الفاشلة:\n"
    int n = array.size(fTime)
    if n <= 0
        s := s + "لا يوجد"
    else
        int shown = math.min(n, 20)
        for i = 0 to shown - 1
            int j = n - 1 - i
            string sd = array.get(fSide, j) == 1 ? "شراء" : "بيع"
            s := s + str.format_time(array.get(fTime, j), "dd/MM HH:mm") + " " + array.get(fTag, j) + " " + sd
            if i < shown - 1
                s := s + "\n"
        if n > shown
            s := s + "\n+" + str.tostring(n - shown) + " أقدم"
    s

f_tag_open(string tag) =>
    bool found = false
    int n = array.size(pTag)
    if n > 0
        for i = 0 to n - 1
            if array.get(pTag, i) == tag
                found := true
                break
    found

f_score_json() =>
    '"wins":' + str.tostring(array.get(tally, 0)) + ',"losses":' + str.tostring(array.get(tally, 1)) + ',"open":' + str.tostring(array.size(pTime))

f_store(int et, string tag, int side, int win, float px) =>
    array.push(hTime, et)
    array.push(hTag, tag)
    array.push(hSide, side)
    array.push(hWin, win)
    if array.size(hTime) > 20
        array.shift(hTime)
        array.shift(hTag)
        array.shift(hSide)
        array.shift(hWin)
    int tIdx = win == 1 ? 0 : 1
    array.set(tally, tIdx, array.get(tally, tIdx) + 1)
    int ti = f_tag_i(tag)
    array.set(tfO, ti, math.max(0, array.get(tfO, ti) - 1))
    if win == 1
        array.set(tfW, ti, array.get(tfW, ti) + 1)
    else
        array.set(tfL, ti, array.get(tfL, ti) + 1)
    if f_in_window(et)
        if win == 1
            array.set(mTally, 0, array.get(mTally, 0) + 1)
            array.set(tfMW, ti, array.get(tfMW, ti) + 1)
        else
            array.set(mTally, 1, array.get(mTally, 1) + 1)
            array.set(tfML, ti, array.get(tfML, ti) + 1)
    if win != 1
        array.push(fTime, time)
        array.push(fTag, tag)
        array.push(fSide, side)
        if array.size(fTime) > 40
            array.shift(fTime)
            array.shift(fTag)
            array.shift(fSide)
    string sideTxt = side == 1 ? "buy" : "sell"
    string winTxt = win == 1 ? "true" : "false"
    alert('{"src":"cascade","event":"result","side":"' + sideTxt + '","tag":"' + tag + '","symbol":"' + syminfo.ticker + '","price":' + str.tostring(px) + ',"win":' + winTxt + ',' + f_score_json() + '}', alert.freq_all)

f_resolve_one(int i) =>
    int et = array.get(pTime, i)
    float px = array.get(pPx, i)
    int side = array.get(pSide, i)
    string tag = array.get(pTag, i)
    float tp = side == 1 ? px * (1.0 + histWin / 100.0) : px * (1.0 - histWin / 100.0)
    float sl = side == 1 ? px * (1.0 - histLoss / 100.0) : px * (1.0 + histLoss / 100.0)
    bool slHit = side == 1 ? low <= sl : high >= sl
    bool tpHit = side == 1 ? high >= tp : low <= tp
    int result = slHit ? 0 : tpHit ? 1 : -1
    if result >= 0
        array.remove(pTime, i)
        array.remove(pPx, i)
        array.remove(pSide, i)
        array.remove(pTag, i)
        f_store(et, tag, side, result, px)
    result

f_track(bool hit, int side, string tag) =>
    bool done = false
    if hit and not f_tag_open(tag)
        array.push(pTime, time)
        array.push(pPx, close)
        array.push(pSide, side)
        array.push(pTag, tag)
        int ti = f_tag_i(tag)
        array.set(tfO, ti, array.get(tfO, ti) + 1)
        string sideTxt = side == 1 ? "buy" : "sell"
        alert('{"src":"cascade","event":"entry","side":"' + sideTxt + '","tag":"' + tag + '","symbol":"' + syminfo.ticker + '","price":' + str.tostring(close) + ',' + f_score_json() + '}', alert.freq_all)
        done := true
    done

f_tf_open(string id) =>
    bool found = false
    int n = strategy.opentrades
    if n > 0
        for i = 0 to n - 1
            if strategy.opentrades.entry_id(i) == id
                found := true
                break
    found

// إذا الأكبر دخل، نلغي الأصغر المفتوح نفس الاتجاه. ما يُحسب ربح ولا خسارة.
f_swallow(string tag, int side, bool biggerHit, string id) =>
    bool did = false
    if biggerHit
        int n = array.size(pTag)
        if n > 0
            for i = n - 1 to 0 by -1
                if array.get(pTag, i) == tag and array.get(pSide, i) == side
                    int ti = f_tag_i(tag)
                    array.remove(pTime, i)
                    array.remove(pPx, i)
                    array.remove(pSide, i)
                    array.remove(pTag, i)
                    array.set(tfO, ti, math.max(0, array.get(tfO, ti) - 1))
                    array.set(casN, 0, array.get(casN, 0) + 1)
                    string sideTxt = side == 1 ? "buy" : "sell"
                    alert('{"src":"cascade","event":"swallow","side":"' + sideTxt + '","tag":"' + tag + '","symbol":"' + syminfo.ticker + '","price":' + str.tostring(close) + ',' + f_score_json() + '}', alert.freq_all)
                    did := true
                    break
        if f_tf_open(id)
            strategy.close(id, comment="ابتلاع")
            did := true
    did

var array<float> lStop = array.new_float(13, na)
var array<float> lLim  = array.new_float(13, na)
var array<float> sStop = array.new_float(13, na)
var array<float> sLim  = array.new_float(13, na)

f_tf_long(bool hit, string id, string opp, string tag, int idx, int baseMin, bool allow) =>
    if hit and useLong and allow
        if exitOpp and f_tf_open(opp)
            strategy.close(opp, comment="عكس")
        if not f_tf_open(id)
            float tp = baseMin <= 30 ? 0.67 : 1.00
            float sl = baseMin <= 30 ? 0.52 : 0.75
            strategy.entry(id, strategy.long, comment="شراء " + tag)
            array.set(lStop, idx, close * (1.0 - sl / 100.0))
            array.set(lLim, idx, close * (1.0 + tp / 100.0))

f_tf_short(bool hit, string id, string opp, string tag, int idx, int baseMin, bool allow) =>
    if hit and useShrt and allow
        if exitOpp and f_tf_open(opp)
            strategy.close(opp, comment="عكس")
        if not f_tf_open(id)
            float tp = baseMin <= 30 ? 0.67 : 1.00
            float sl = baseMin <= 30 ? 0.52 : 0.75
            strategy.entry(id, strategy.short, comment="بيع " + tag)
            array.set(sStop, idx, close * (1.0 + sl / 100.0))
            array.set(sLim, idx, close * (1.0 - tp / 100.0))

f_tf_keep(string id, string xid, int idx, bool isLong) =>
    float stopPx = isLong ? array.get(lStop, idx) : array.get(sStop, idx)
    float limPx = isLong ? array.get(lLim, idx) : array.get(sLim, idx)
    if usePct and not na(stopPx) and not na(limPx)
        strategy.exit(xid, from_entry=id, stop=stopPx, limit=limPx)

f_smi() =>
    ll = ta.lowest(low, smiK)
    hh = ta.highest(high, smiK)
    diff = hh - ll
    rdiff = close - (hh + ll) / 2.0
    avgrel = ta.ema(ta.ema(rdiff, smiD), smiD)
    avgdiff = ta.ema(ta.ema(diff, smiD), smiD)
    avgdiff != 0 ? (avgrel / (avgdiff / 2.0)) * 100.0 : 0.0

f_don() =>
    var float trend = 0.0
    hh = ta.highest(high, dlen)
    ll = ta.lowest(low, dlen)
    trend := close > hh[1] ? 1.0 : close < ll[1] ? -1.0 : trend
    trend

f_macd_ok(bool isLong, float smi, float hist, float macd) =>
    bool ok = false
    bool sat = isLong ? smi[1] <= osLvl : smi[1] >= obLvl
    if sat
        int off = 1
        for i = 2 to 50
            bool still = isLong ? smi[i] <= osLvl : smi[i] >= obLvl
            if not still
                break
            off := i
        float h0 = hist[off]
        float m0 = macd[off]
        if not na(h0) and not na(m0)
            ok := isLong ? (h0 < 0 and m0 >= h0) : (h0 > 0 and m0 <= h0)
    ok

f_ema_ok(bool isLong, float smi, float ema, float cl) =>
    bool found = false
    bool satNow = isLong ? smi[1] <= osLvl : smi[1] >= obLvl
    if satNow
        for i = 1 to 50
            bool sat = isLong ? smi[i] <= osLvl : smi[i] >= obLvl
            if not sat
                break
            if isLong and cl[i] < ema[i]
                found := true
                break
            if not isLong and cl[i] > ema[i]
                found := true
                break
    found

f_rsi_conf(bool isLong, float rsi) =>
    bool bad = false
    for i = 1 to rsiLook
        if not na(rsi[i])
            if isLong and rsi[i] >= rsiConfOb
                bad := true
                break
            if not isLong and rsi[i] <= rsiConfOs
                bad := true
                break
    not bad

f_rsi_base(bool isLong, float rsi) =>
    bool bad = false
    for i = 0 to rsiLook - 1
        if not na(rsi[i])
            if isLong and rsi[i] >= rsiConfOb
                bad := true
                break
            if not isLong and rsi[i] <= rsiConfOs
                bad := true
                break
    not bad

f_sat(bool isLong, float v) =>
    not na(v) and (isLong ? v <= osLvl : v >= obLvl)

// قيم جاهزة (حالي + إغلاق 1 + إغلاق 2) عشان history داخل security ما ينكسر.
f_blk3(bool isLong, float a, float b, float c) =>
    f_sat(isLong, a) or f_sat(isLong, b) or f_sat(isLong, c)

f_step8(bool isLong, float smi, float rsi, float rsiMa, float k) =>
    float smiTh = isLong ? osLvl : obLvl
    float rsiTh = isLong ? rsiOs : rsiOb  // إغلاق الدخول أثناء التشبع: شراء <=35 | بيع >=65
    float stTh  = isLong ? stochBuy : stochSell
    bool ok = false
    int smiIdx = -1
    bool sat1 = isLong ? smi[1] <= smiTh : smi[1] >= smiTh
    if sat1
        smiIdx := 1
        for i = 2 to 60
            bool satI = isLong ? smi[i] <= smiTh : smi[i] >= smiTh
            if not satI
                break
            smiIdx := i
    else
        int lastSat = -1
        for i = 1 to 60
            bool satI = isLong ? smi[i] <= smiTh : smi[i] >= smiTh
            if satI
                lastSat := i
                break
        if lastSat > 0
            smiIdx := lastSat
            for i = lastSat + 1 to 60
                bool satI = isLong ? smi[i] <= smiTh : smi[i] >= smiTh
                if not satI
                    break
                smiIdx := i
    if smiIdx > 0
        int rsiIdx = -1
        for i = smiIdx to 1
            bool rHit = isLong ? rsi[i] <= rsiTh : rsi[i] >= rsiTh
            if rHit
                rsiIdx := i
                break
        if rsiIdx > 0
            int crossIdx = -1
            for i = rsiIdx to 1
                float prevR = rsi[i + 1]
                float prevM = rsiMa[i + 1]
                float curR  = rsi[i]
                float curM  = rsiMa[i]
                if not na(prevR) and not na(prevM) and not na(curR) and not na(curM)
                    bool crossed = isLong ? (prevR < prevM and curR >= curM) : (prevR > prevM and curR <= curM)
                    if crossed
                        crossIdx := i
                        break
            if crossIdx > 0
                int newest = math.max(1, crossIdx - stochGap)
                for j = crossIdx to newest
                    if not na(k[j])
                        bool st = isLong ? k[j] > stTh : k[j] < stTh
                        if st
                            ok := true
                            break
    ok

// security على فريم أدنى من الشارت ترجع آخر شمعة فقط (مو كل na).
// security_lower_tf تلقط كل الشموع داخل الساعة، لكن تنهار مع 36 فريم (حد 40 طلب) وتفشل إذا الشارت أصغر من المطلوب.
f_snap_entry() =>
    smi = f_smi()
    don = f_don()
    rsi = ta.rsi(close, rsiLen)
    rsiMa = ta.sma(rsi, rsiLen)
    k = ta.sma(ta.stoch(close, high, low, stKlen), stKsm)
    [don[1], f_step8(true, smi, rsi, rsiMa, k), f_step8(false, smi, rsi, rsiMa, k)]

f_snap_confirm() =>
    [macdLine, sigLine, hist] = ta.macd(close, macdF, macdS, macdG)
    don = f_don()
    rsi = ta.rsi(close, rsiLen)
    hist2 = hist + nz(sigLine) * 0.0 + nz(macdLine) * 0.0
    [don, hist2, f_rsi_conf(true, rsi), f_rsi_conf(false, rsi)]

f_snap_base() =>
    smi = f_smi()
    [macdLine, sigLine, hist] = ta.macd(close, macdF, macdS, macdG)
    don = f_don()
    ema = ta.ema(close, emaLen)
    rsi = ta.rsi(close, rsiLen)
    hist2 = hist + nz(sigLine) * 0.0
    [smi[1], don[1], f_macd_ok(true, smi, hist2, macdLine), f_macd_ok(false, smi, hist2, macdLine), f_ema_ok(true, smi, ema, close) and f_rsi_base(true, rsi), f_ema_ok(false, smi, ema, close) and f_rsi_base(false, rsi), f_blk3(true, smi, smi[1], smi[2]), f_blk3(false, smi, smi[1], smi[2])]

f_snap_cancel() =>
    smi = f_smi()
    [smi[1], f_blk3(true, smi, smi[1], smi[2]), f_blk3(false, smi, smi[1], smi[2])]

f_snap_base_entry() =>
    smi = f_smi()
    [macdLine, sigLine, hist] = ta.macd(close, macdF, macdS, macdG)
    don = f_don()
    ema = ta.ema(close, emaLen)
    rsi = ta.rsi(close, rsiLen)
    rsiMa = ta.sma(rsi, rsiLen)
    k = ta.sma(ta.stoch(close, high, low, stKlen), stKsm)
    hist2 = hist + nz(sigLine) * 0.0
    [smi[1], don[1], f_macd_ok(true, smi, hist2, macdLine), f_macd_ok(false, smi, hist2, macdLine), f_ema_ok(true, smi, ema, close) and f_rsi_base(true, rsi), f_ema_ok(false, smi, ema, close) and f_rsi_base(false, rsi), f_step8(true, smi, rsi, rsiMa, k), f_step8(false, smi, rsi, rsiMa, k), f_blk3(true, smi, smi[1], smi[2]), f_blk3(false, smi, smi[1], smi[2])]

f_snap_htf() =>
    smi = f_smi()
    [macdLine, sigLine, hist] = ta.macd(close, macdF, macdS, macdG)
    don = f_don()
    ema = ta.ema(close, emaLen)
    rsi = ta.rsi(close, rsiLen)
    hist2 = hist + nz(sigLine) * 0.0
    [smi[1], don, don[1], hist2, f_macd_ok(true, smi, hist2, macdLine), f_macd_ok(false, smi, hist2, macdLine), f_ema_ok(true, smi, ema, close) and f_rsi_base(true, rsi), f_ema_ok(false, smi, ema, close) and f_rsi_base(false, rsi), f_rsi_conf(true, rsi), f_rsi_conf(false, rsi), f_blk3(true, smi, smi[1], smi[2]), f_blk3(false, smi, smi[1], smi[2])]

f_req_entry(simple string tf) =>
    request.security(syminfo.tickerid, tf, f_snap_entry(), barmerge.gaps_off, barmerge.lookahead_off)

f_req_confirm(simple string tf) =>
    request.security(syminfo.tickerid, tf, f_snap_confirm(), barmerge.gaps_off, barmerge.lookahead_off)

f_req_base(simple string tf) =>
    request.security(syminfo.tickerid, tf, f_snap_base(), barmerge.gaps_off, barmerge.lookahead_off)

f_req_cancel(simple string tf) =>
    request.security(syminfo.tickerid, tf, f_snap_cancel(), barmerge.gaps_off, barmerge.lookahead_off)

f_req_base_entry(simple string tf) =>
    request.security(syminfo.tickerid, tf, f_snap_base_entry(), barmerge.gaps_off, barmerge.lookahead_off)

f_req_htf(simple string tf) =>
    request.security(syminfo.tickerid, tf, f_snap_htf(), barmerge.gaps_off, barmerge.lookahead_off)

