f_side(bool isLong, bool blk, float smiC, bool mOk, float donB, float donCf, float rocCf, int emaT, bool rsiCf, float rsiM, float rsiC, float donT, int s8T, int entT) =>
    bool s1 = not blk and not na(smiC) and (isLong ? smiC <= osLvl : smiC >= obLvl)
    bool s2 = mOk
    bool s3 = isLong ? donB == 1 : donB == -1
    bool s4 = true
    bool s5 = isLong ? (not na(rocCf) and rocCf > 0) : (not na(rocCf) and rocCf < 0)
    bool s6 = not na(emaT) and rsiCf and f_rsi_band(isLong, rsiC) and f_rsi_gap(rsiM, rsiC)
    bool donOpp = isLong ? donT == -1 : donT == 1
    var int t7 = na
    if na(emaT)
        t7 := na
    else if s6 and na(t7) and donOpp and not na(entT) and entT >= emaT
        t7 := entT
    bool s7 = not na(t7)
    bool s8 = s7 and not na(s8T) and s8T >= t7
    bool setup = s1 and s2 and s3 and s5 and s6 and s7
    bool all8 = setup and s8
    [s1, s2, s3, s4, s5, s6, s7, s8, setup, all8]

