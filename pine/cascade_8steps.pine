f_side(bool isLong, bool blk, float smiC, bool mOk, float donB, float donCf, float histCf, bool emaOk, bool rsiCf, float donT, bool s8) =>
    bool s1 = not blk and not na(smiC) and (isLong ? smiC <= osLvl : smiC >= obLvl)
    bool s2 = mOk
    bool s3 = isLong ? donB == 1 : donB == -1
    bool s4 = isLong ? donCf == 1 : donCf == -1  // تأكيد: شراء أخضر | بيع أحمر
    bool s5 = isLong ? (not na(histCf) and histCf > 0) : (not na(histCf) and histCf < 0)
    bool s6 = emaOk and rsiCf
    bool s7 = isLong ? donT == -1 : donT == 1  // دخول: شراء Donchian أحمر | بيع أخضر
    bool smiDir = isLong ? smiC < 0 : smiC > 0
    bool setup = s1 and s2 and s3 and s4 and s5 and s6 and s7 and smiDir
    bool all8 = setup and s8
    [s1, s2, s3, s4, s5, s6, s7, s8, setup, all8]

