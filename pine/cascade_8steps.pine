f_mark(bool v) => v ? "1" : ""

f_row(string nm, bool s1, bool s2, bool s3, bool s4, bool s5, bool s6, bool s7, bool s8) =>
    nm + f_mark(s1) + f_mark(s2) + f_mark(s3) + f_mark(s4) + f_mark(s5) + f_mark(s6) + f_mark(s7) + f_mark(s8)

f_sc(int i) =>
    " " + str.tostring(array.get(tfW, i)) + "✓" + str.tostring(array.get(tfL, i)) + "✗" + str.tostring(array.get(tfO, i)) + "○"

f_cell(table t, int col, int row, string txt, color fg, color bg) =>
    table.cell(t, col, row, txt, text_color=fg, bgcolor=bg, text_size=size.small, text_halign=text.align_center)

f_tf_row(table t, int row, string nm, int i) =>
    color bg = row % 2 == 0 ? color.new(#1a1a1a, 0) : color.new(#222222, 0)
    f_cell(t, 0, row, nm, color.white, bg)
    f_cell(t, 1, row, str.tostring(array.get(tfMW, i)), color.lime, bg)
    f_cell(t, 2, row, str.tostring(array.get(tfML, i)), color.red, bg)
    f_cell(t, 3, row, str.tostring(f_month_tf_open(i)), color.orange, bg)

