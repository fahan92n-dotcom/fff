//@version=5
// Cascade 8 خطوات — 13 زوجاً معاً. الشارت لازم 20 دقيقة أو أقل حتى تظهر الأسهم التاريخية.
// زوج الساعة = 60/180/20 (تشبع على 60م، تأكيد 180م، دخول 20م) وليس «حط الشارت على ساعة».
// request.security على فريم أدنى ترجع آخر شمعة فقط (مو كل na). security_lower_tf لا تُستخدم: حد 40 طلب + تفشل إذا الشارت أصغر.
// step8 فقط على فريمات الدخول. Donchian بـ var حتى يثبت عبر استدعاءات security.
// MACD: شراء خط فوق الهستوجرام الأحمر وتحت 20٪ من أعلى موجة | بيع تحت الأخضر وفوق 20٪ من أدنى موجة
// تنبيه تلقرام: أنشئ Alert → Any alert() function call → Webhook /tv?token=SECRET
// النتائج على الشارت: عدّاد ناجحة/فاشلة + RSI الفريم الرئيسي والتأكيد لكل صفقة عند الدخول.
// صفحة النتائج من الإعدادات (20 صفقة في الصفحة، يُحفظ آخر 100).
strategy("Cascade 8 — كل الفريمات (شارت 20م)",
     overlay                  = true,
     pyramiding               = 0,
     initial_capital          = 100000,
     currency                 = currency.USD,
     default_qty_type         = strategy.percent_of_equity,
     default_qty_value        = 2,
     commission_type          = strategy.commission.percent,
     commission_value         = 0.04,
     process_orders_on_close  = true,
     calc_on_every_tick       = false,
     max_labels_count         = 500,
     max_bars_back            = 1000)

grpInd = "المؤشرات"
smiK   = input.int(10, "SMI K", minval=1, group=grpInd)
smiD   = input.int(3,  "SMI D", minval=1, group=grpInd)
osLvl  = input.float(-40, "تشبع بيعي SMI", group=grpInd)
obLvl  = input.float(40,  "تشبع شرائي SMI", group=grpInd)
macdF  = input.int(12, "MACD Fast", minval=1, group=grpInd)
macdS  = input.int(26, "MACD Slow", minval=1, group=grpInd)
macdG  = input.int(9,  "MACD Sig",  minval=1, group=grpInd)
macdPct = input.float(20.0, "سقف/أرضية خط MACD ٪", minval=0, maxval=100, step=1, group=grpInd)
dlen   = input.int(20, "Donchian Length", minval=2, group=grpInd)
emaLen = input.int(50, "EMA", minval=1, group=grpInd)
rsiLen = input.int(14, "RSI", minval=2, group=grpInd)
stKlen = input.int(15, "Stoch K", minval=1, group=grpInd)
stKsm  = input.int(3,  "Stoch K Smooth", minval=1, group=grpInd)
rsiOs  = input.float(35, "لمس RSI شراء", group=grpInd)
rsiOb  = input.float(65, "لمس RSI بيع", group=grpInd)
rsiConfOs = input.float(30, "RSI تأكيد ممنوع <=", group=grpInd)
rsiConfOb = input.float(70, "RSI تأكيد ممنوع >=", group=grpInd)
rsiLook   = input.int(30, "RSI تأكيد شموع", minval=1, group=grpInd)
stochBuy  = input.float(20, "Stoch شراء >", group=grpInd)
stochSell = input.float(80, "Stoch بيع <", group=grpInd)
stochGap  = input.int(3, "Stoch بعد التقاطع", minval=0, group=grpInd)

grpP = "الأزواج"
use15  = input.bool(true, "15 / 45 / 5", group=grpP)
use18  = input.bool(true, "18 / 54 / 6", group=grpP)
use21  = input.bool(true, "21 / 63 / 7", group=grpP)
use24  = input.bool(true, "24 / 72 / 8", group=grpP)
use27  = input.bool(true, "27 / 81 / 9", group=grpP)
use30  = input.bool(true, "30 / 90 / 10", group=grpP)
use45  = input.bool(true, "45 / 135 / 15", group=grpP)
use60  = input.bool(true, "60 / 180 / 20", group=grpP)
use90  = input.bool(true, "90 / 270 / 30", group=grpP)
use120 = input.bool(true, "120 / 360 / 40", group=grpP)
use150 = input.bool(true, "150 / 450 / 50", group=grpP)
use210 = input.bool(true, "210 / 630 / 70", group=grpP)
use240 = input.bool(true, "240 / 720 / 80", group=grpP)

grpRisk = "إغلاق"
useLong = input.bool(true, "شراء", group=grpRisk)
useShrt = input.bool(true, "بيع", group=grpRisk)
usePct  = input.bool(true, "وقف/هدف %", group=grpRisk)
exitOpp = input.bool(true, "إغلاق عكسي", group=grpRisk)

grpVis = "العرض"
showBg  = input.bool(true, "تظليل", group=grpVis)
showLog = input.bool(true, "لوحة كل الفريمات", group=grpVis)
showLbl = input.bool(true, "ملصقات الدخول", group=grpVis)
showScore = input.bool(true, "نتائج الصفقات + RSI", group=grpVis)
scorePage = input.int(1, "صفحة النتائج", minval=1, group=grpVis)
histWin  = input.float(0.67, "ربح الصفقة %", step=0.01, group=grpVis)
histLoss = input.float(0.53, "خسارة الصفقة %", step=0.01, group=grpVis)
histKeep = 100
pageSize = 20

var array<int>    pTime = array.new_int()
var array<float>  pPx   = array.new_float()
var array<int>    pSide = array.new_int()
var array<string> pTag  = array.new_string()
var array<float>  pRsiM = array.new_float()
var array<float>  pRsiC = array.new_float()
var array<int>    hTime = array.new_int()
var array<string> hTag  = array.new_string()
var array<int>    hSide = array.new_int()
var array<int>    hWin  = array.new_int()
var array<float>  hRsiM = array.new_float()
var array<float>  hRsiC = array.new_float()
var array<int>    tally = array.new_int(2, 0)
var int firstBarTime = time

f_rsi_txt(float v) =>
    na(v) ? "—" : str.tostring(v, "#.#")

f_score_json() =>
    '"wins":' + str.tostring(array.get(tally, 0)) + ',"losses":' + str.tostring(array.get(tally, 1)) + ',"open":' + str.tostring(array.size(pTime))

f_store(int et, string tag, int side, int win, float px, float rsiM, float rsiC) =>
    array.push(hTime, et)
    array.push(hTag, tag)
    array.push(hSide, side)
    array.push(hWin, win)
    array.push(hRsiM, rsiM)
    array.push(hRsiC, rsiC)
    if array.size(hTime) > histKeep
        array.shift(hTime)
        array.shift(hTag)
        array.shift(hSide)
        array.shift(hWin)
        array.shift(hRsiM)
        array.shift(hRsiC)
    int tIdx = win == 1 ? 0 : 1
    array.set(tally, tIdx, array.get(tally, tIdx) + 1)
    string sideTxt = side == 1 ? "buy" : "sell"
    string winTxt = win == 1 ? "true" : "false"
    alert('{"src":"cascade","event":"result","side":"' + sideTxt + '","tag":"' + tag + '","symbol":"' + syminfo.ticker + '","price":' + str.tostring(px) + ',"win":' + winTxt + ',"rsi_main":' + str.tostring(rsiM) + ',"rsi_confirm":' + str.tostring(rsiC) + ',' + f_score_json() + '}', alert.freq_all)

f_resolve_one(int i) =>
    int et = array.get(pTime, i)
    float px = array.get(pPx, i)
    int side = array.get(pSide, i)
    string tag = array.get(pTag, i)
    float rsiM = array.get(pRsiM, i)
    float rsiC = array.get(pRsiC, i)
    float tp = side == 1 ? px * (1.0 + histWin / 100.0) : px * (1.0 - histWin / 100.0)
    float sl = side == 1 ? px * (1.0 - histLoss / 100.0) : px * (1.0 + histLoss / 100.0)
    bool slHit = side == 1 ? low <= sl : high >= sl
    bool tpHit = side == 1 ? high >= tp : low <= tp
    int result = slHit ? 0 : tpHit ? 1 : -1
    if result >= 0
        f_store(et, tag, side, result, px, rsiM, rsiC)
        array.remove(pTime, i)
        array.remove(pPx, i)
        array.remove(pSide, i)
        array.remove(pTag, i)
        array.remove(pRsiM, i)
        array.remove(pRsiC, i)
    result

f_track(bool hit, int side, string tag, float rsiM, float rsiC) =>
    bool done = false
    if hit
        array.push(pTime, time)
        array.push(pPx, close)
        array.push(pSide, side)
        array.push(pTag, tag)
        array.push(pRsiM, rsiM)
        array.push(pRsiC, rsiC)
        string sideTxt = side == 1 ? "buy" : "sell"
        alert('{"src":"cascade","event":"entry","side":"' + sideTxt + '","tag":"' + tag + '","symbol":"' + syminfo.ticker + '","price":' + str.tostring(close) + ',"rsi_main":' + str.tostring(rsiM) + ',"rsi_confirm":' + str.tostring(rsiC) + '}', alert.freq_all)
        done := true
    done

f_smi() =>
    ll = ta.lowest(low, smiK)
    hh = ta.highest(high, smiK)
    diff = hh - ll
    rdiff = close - (hh + ll) / 2.0
    avgrel = ta.ema(ta.ema(rdiff, smiD), smiD)
    avgdiff = ta.ema(ta.ema(diff, smiD), smiD)
    avgdiff != 0 ? (avgrel / (avgdiff / 2.0)) * 100.0 : 0.0

f_don() =>
    var float trend = 0.0
    hh = ta.highest(high, dlen)
    ll = ta.lowest(low, dlen)
    trend := close > hh[1] ? 1.0 : close < ll[1] ? -1.0 : trend
    trend

f_macd_ok(bool isLong, float smi, float hist, float macd) =>
    bool ok = false
    bool sat = isLong ? smi[1] <= osLvl : smi[1] >= obLvl
    if sat
        int off = 1
        for i = 2 to 50
            bool still = isLong ? smi[i] <= osLvl : smi[i] >= obLvl
            if not still
                break
            off := i
        float h0 = hist[off]
        float m0 = macd[off]
        if not na(h0) and not na(m0)
            bool sideOk = isLong ? (h0 < 0 and m0 >= h0) : (h0 > 0 and m0 <= h0)
            if sideOk
                int sec = timeframe.in_seconds()
                int winHours = sec <= 3600 ? 24 : 72
                int winBars = int(math.max(2, math.round(winHours * 3600.0 / sec)))
                if winBars > 300
                    winBars := 300
                float bound = 0.0
                int last = off + winBars - 1
                for j = off to last
                    float v = macd[j]
                    if not na(v)
                        if isLong and v > 0 and v > bound
                            bound := v
                        if not isLong and v < 0 and v < bound
                            bound := v
                float cap = bound * (macdPct / 100.0)
                ok := isLong ? m0 <= cap : m0 >= cap
    ok

f_ema_ok(bool isLong, float smi, float ema, float cl) =>
    bool found = false
    bool satNow = isLong ? smi[1] <= osLvl : smi[1] >= obLvl
    if satNow
        for i = 1 to 50
            bool sat = isLong ? smi[i] <= osLvl : smi[i] >= obLvl
            if not sat
                break
            if isLong and cl[i] < ema[i]
                found := true
                break
            if not isLong and cl[i] > ema[i]
                found := true
                break
    found

f_rsi_conf(bool isLong, float rsi) =>
    bool bad = false
    for i = 0 to rsiLook - 1
        if not na(rsi[i])
            if isLong and rsi[i] <= rsiConfOs
                bad := true
                break
            if not isLong and rsi[i] >= rsiConfOb
                bad := true
                break
    not bad

f_block(bool isLong, float smi) =>
    bool sat0 = isLong ? smi <= osLvl : smi >= obLvl
    bool blocked = sat0
    if not sat0
        int last = -1
        for i = 1 to 5
            bool s = isLong ? smi[i] <= osLvl : smi[i] >= obLvl
            if s
                last := i
                break
        blocked := last == 1 or last == 2
    blocked

f_step8(bool isLong, float smi, float rsi, float rsiMa, float k) =>
    float smiTh = isLong ? osLvl : obLvl
    float rsiTh = isLong ? rsiOs : rsiOb
    float stTh  = isLong ? stochBuy : stochSell
    bool ok = false
    int smiIdx = -1
    bool sat1 = isLong ? smi[1] <= smiTh : smi[1] >= smiTh
    if sat1
        smiIdx := 1
        for i = 2 to 60
            bool satI = isLong ? smi[i] <= smiTh : smi[i] >= smiTh
            if not satI
                break
            smiIdx := i
    else
        int lastSat = -1
        for i = 1 to 60
            bool satI = isLong ? smi[i] <= smiTh : smi[i] >= smiTh
            if satI
                lastSat := i
                break
        if lastSat > 0
            smiIdx := lastSat
            for i = lastSat + 1 to 60
                bool satI = isLong ? smi[i] <= smiTh : smi[i] >= smiTh
                if not satI
                    break
                smiIdx := i
    if smiIdx > 0
        int rsiIdx = -1
        for i = smiIdx to 1
            bool rHit = isLong ? rsi[i] <= rsiTh : rsi[i] >= rsiTh
            if rHit
                rsiIdx := i
                break
        if rsiIdx > 0
            int crossIdx = -1
            for i = rsiIdx to 1
                float prevR = rsi[i + 1]
                float prevM = rsiMa[i + 1]
                float curR  = rsi[i]
                float curM  = rsiMa[i]
                if not na(prevR) and not na(prevM) and not na(curR) and not na(curM)
                    bool crossed = isLong ? (prevR < prevM and curR >= curM) : (prevR > prevM and curR <= curM)
                    if crossed
                        crossIdx := i
                        break
            if crossIdx > 0
                int newest = math.max(1, crossIdx - stochGap)
                for j = crossIdx to newest
                    if not na(k[j])
                        bool st = isLong ? k[j] > stTh : k[j] < stTh
                        if st
                            ok := true
                            break
    ok

// security على فريم أدنى من الشارت ترجع آخر شمعة فقط (مو كل na).
// security_lower_tf تلقط كل الشموع داخل الساعة، لكن تنهار مع 36 فريم (حد 40 طلب) وتفشل إذا الشارت أصغر من المطلوب.
f_snap_entry() =>
    smi = f_smi()
    don = f_don()
    rsi = ta.rsi(close, rsiLen)
    rsiMa = ta.sma(rsi, rsiLen)
    k = ta.sma(ta.stoch(close, high, low, stKlen), stKsm)
    [don[1], f_step8(true, smi, rsi, rsiMa, k), f_step8(false, smi, rsi, rsiMa, k)]

f_snap_confirm() =>
    [macdLine, sigLine, hist] = ta.macd(close, macdF, macdS, macdG)
    don = f_don()
    rsi = ta.rsi(close, rsiLen)
    hist2 = hist + nz(sigLine) * 0.0 + nz(macdLine) * 0.0
    [don, hist2, f_rsi_conf(true, rsi), f_rsi_conf(false, rsi), rsi]

f_snap_base() =>
    smi = f_smi()
    [macdLine, sigLine, hist] = ta.macd(close, macdF, macdS, macdG)
    don = f_don()
    ema = ta.ema(close, emaLen)
    rsi = ta.rsi(close, rsiLen)
    hist2 = hist + nz(sigLine) * 0.0
    [smi[1], don[1], f_macd_ok(true, smi, hist2, macdLine), f_macd_ok(false, smi, hist2, macdLine), f_ema_ok(true, smi, ema, close), f_ema_ok(false, smi, ema, close), f_block(true, smi), f_block(false, smi), rsi]

f_snap_cancel() =>
    smi = f_smi()
    [f_block(true, smi), f_block(false, smi)]

f_snap_base_entry() =>
    smi = f_smi()
    [macdLine, sigLine, hist] = ta.macd(close, macdF, macdS, macdG)
    don = f_don()
    ema = ta.ema(close, emaLen)
    rsi = ta.rsi(close, rsiLen)
    rsiMa = ta.sma(rsi, rsiLen)
    k = ta.sma(ta.stoch(close, high, low, stKlen), stKsm)
    hist2 = hist + nz(sigLine) * 0.0
    [smi[1], don[1], f_macd_ok(true, smi, hist2, macdLine), f_macd_ok(false, smi, hist2, macdLine), f_ema_ok(true, smi, ema, close), f_ema_ok(false, smi, ema, close), f_step8(true, smi, rsi, rsiMa, k), f_step8(false, smi, rsi, rsiMa, k), f_block(true, smi), f_block(false, smi), rsi]

f_snap_htf() =>
    smi = f_smi()
    [macdLine, sigLine, hist] = ta.macd(close, macdF, macdS, macdG)
    don = f_don()
    ema = ta.ema(close, emaLen)
    rsi = ta.rsi(close, rsiLen)
    hist2 = hist + nz(sigLine) * 0.0
    [smi[1], don, don[1], hist2, f_macd_ok(true, smi, hist2, macdLine), f_macd_ok(false, smi, hist2, macdLine), f_ema_ok(true, smi, ema, close), f_ema_ok(false, smi, ema, close), f_rsi_conf(true, rsi), f_rsi_conf(false, rsi), f_block(true, smi), f_block(false, smi), rsi]

f_req_entry(simple string tf) =>
    request.security(syminfo.tickerid, tf, f_snap_entry(), barmerge.gaps_off, barmerge.lookahead_off)

f_req_confirm(simple string tf) =>
    request.security(syminfo.tickerid, tf, f_snap_confirm(), barmerge.gaps_off, barmerge.lookahead_off)

f_req_base(simple string tf) =>
    request.security(syminfo.tickerid, tf, f_snap_base(), barmerge.gaps_off, barmerge.lookahead_off)

f_req_cancel(simple string tf) =>
    request.security(syminfo.tickerid, tf, f_snap_cancel(), barmerge.gaps_off, barmerge.lookahead_off)

f_req_base_entry(simple string tf) =>
    request.security(syminfo.tickerid, tf, f_snap_base_entry(), barmerge.gaps_off, barmerge.lookahead_off)

f_req_htf(simple string tf) =>
    request.security(syminfo.tickerid, tf, f_snap_htf(), barmerge.gaps_off, barmerge.lookahead_off)

[dC5, s8L5, s8S5] = f_req_entry("5")
[dC6, s8L6, s8S6] = f_req_entry("6")
[dC7, s8L7, s8S7] = f_req_entry("7")
[dC8, s8L8, s8S8] = f_req_entry("8")
[dC9, s8L9, s8S9] = f_req_entry("9")
[dC10, s8L10, s8S10] = f_req_entry("10")
[smi15, dC15, mL15, mS15, eL15, eS15, s8L15, s8S15, bL15, bS15, rsi15] = f_req_base_entry("15")
[smi18, dC18, mL18, mS18, eL18, eS18, bL18, bS18, rsi18] = f_req_base("18")
[dC20, s8L20, s8S20] = f_req_entry("20")
[smi21, dC21, mL21, mS21, eL21, eS21, bL21, bS21, rsi21] = f_req_base("21")
