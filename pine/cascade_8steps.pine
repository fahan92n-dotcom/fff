var table scoreBox = table.new(position.top_left, 1, 3, bgcolor=color.new(#141414, 4), border_width=1, border_color=color.new(#555555, 0), frame_color=color.new(#777777, 25), frame_width=1)
var table monthBox = table.new(position.top_right, 1, 5, bgcolor=color.new(#141414, 4), border_width=1, border_color=color.new(#555555, 0), frame_color=color.new(#777777, 25), frame_width=1)
var table tfTab = table.new(position.bottom_center, 4, 15, bgcolor=color.new(#141414, 0), border_width=1, border_color=color.new(#555555, 0), frame_color=color.new(#777777, 25), frame_width=1)

if barstate.islast
    if showScore
        int wins = array.get(tally, 0)
        int losses = array.get(tally, 1)
        int nOpen = array.size(pTime)
        table.cell(scoreBox, 0, 0, "مجموع الـ13 فريم", text_color=color.white, bgcolor=color.new(#1b3a5c, 0), text_size=size.normal, text_halign=text.align_center)
        table.cell(scoreBox, 0, 1, "ناجحة  " + str.tostring(wins), text_color=color.lime, bgcolor=color.new(#1a1a1a, 0), text_size=size.large, text_halign=text.align_center)
        table.cell(scoreBox, 0, 2, "فاشلة  " + str.tostring(losses), text_color=color.red, bgcolor=color.new(#1a1a1a, 0), text_size=size.large, text_halign=text.align_center)
        int mOpen = f_month_open()
        color mHd = color.new(#3a1b5c, 0)
        table.cell(monthBox, 0, 0, "آخر 3 شهور", text_color=color.white, bgcolor=mHd, text_size=size.normal, text_halign=text.align_center)
        table.cell(monthBox, 0, 1, "من شموع الشارت 5م", text_color=color.white, bgcolor=mHd, text_size=size.small, text_halign=text.align_center)
        table.cell(monthBox, 0, 2, "ناجحة  " + str.tostring(array.get(mTally, 0)), text_color=color.lime, bgcolor=color.new(#1a1a1a, 0), text_size=size.large, text_halign=text.align_center)
        table.cell(monthBox, 0, 3, "فاشلة  " + str.tostring(array.get(mTally, 1)), text_color=color.red, bgcolor=color.new(#1a1a1a, 0), text_size=size.large, text_halign=text.align_center)
        table.cell(monthBox, 0, 4, "مفتوحة  " + str.tostring(mOpen), text_color=color.orange, bgcolor=color.new(#1a1a1a, 0), text_size=size.normal, text_halign=text.align_center)
        color hd = color.new(#1b3a5c, 0)
        f_cell(tfTab, 0, 0, "فريم آخر 3 شهور", color.white, hd)
        f_cell(tfTab, 1, 0, "ناجحة", color.lime, hd)
        f_cell(tfTab, 2, 0, "فاشلة", color.red, hd)
        f_cell(tfTab, 3, 0, "مفتوحة", color.orange, hd)
        f_tf_row(tfTab, 1, "15", 0)
        f_tf_row(tfTab, 2, "18", 1)
        f_tf_row(tfTab, 3, "21", 2)
        f_tf_row(tfTab, 4, "24", 3)
        f_tf_row(tfTab, 5, "27", 4)
        f_tf_row(tfTab, 6, "30", 5)
        f_tf_row(tfTab, 7, "45", 6)
        f_tf_row(tfTab, 8, "60", 7)
        f_tf_row(tfTab, 9, "90", 8)
        f_tf_row(tfTab, 10, "120", 9)
        f_tf_row(tfTab, 11, "150", 10)
        f_tf_row(tfTab, 12, "210", 11)
        f_tf_row(tfTab, 13, "240", 12)
        color totBg = color.new(#0b2a4a, 0)
        table.cell(tfTab, 0, 14, "مجموع 3 شهور", text_color=color.white, bgcolor=totBg, text_size=size.normal, text_halign=text.align_center)
        table.cell(tfTab, 1, 14, str.tostring(array.get(mTally, 0)), text_color=color.lime, bgcolor=totBg, text_size=size.normal, text_halign=text.align_center)
        table.cell(tfTab, 2, 14, str.tostring(array.get(mTally, 1)), text_color=color.red, bgcolor=totBg, text_size=size.normal, text_halign=text.align_center)
        table.cell(tfTab, 3, 14, str.tostring(mOpen), text_color=color.orange, bgcolor=totBg, text_size=size.normal, text_halign=text.align_center)
    else
        table.clear(scoreBox, 0, 0, 0, 2)
        table.clear(monthBox, 0, 0, 0, 4)
        table.clear(tfTab, 0, 0, 3, 14)

alertcondition(buyHit, title="شراء", message="Cascade شراء")
alertcondition(sellHit, title="بيع", message="Cascade بيع")
