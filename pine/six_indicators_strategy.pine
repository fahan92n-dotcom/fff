//@version=5
// أساس استراتيجية 6 مؤشرات — حسابات المؤشرات بإعدادات صاحب الاستراتيجية فقط.
// لا توجد أي قواعد دخول أو خروج هنا بعد: القواعد ستُضاف حرفياً حسب شرح صاحب الاستراتيجية.
//
// المؤشرات والإعدادات (كما وردت في الصور):
//   1) MACD                 : مصدر إغلاق، سريع 12، بطيء 26، إشارة 9، Oscillator MA: EMA، Signal MA: EMA
//   2) Stochastic SMI       : Stoch_MTM — Percent K = 10، Percent D = 3، EMA Signal = 10،
//                             Smoothing Period = 1، تشبع شرائي +40، تشبع بيعي -40
//   3) Stochastic           : طول %K = 15، تنعيم %K = 3، تنعيم %D = 3
//   4) RSI                  : الطول 14، المصدر إغلاق، تنعيم SMA بطول 14
//   5) Donchian Trend Ribbon: كود LonesomeTheBlue — Donchian Channel Period = 20 (أخضر/أحمر)
//   6) EMA 50
strategy("استراتيجية 6 مؤشرات — MACD+SMI+Stoch+RSI+Donchian+EMA50",
     overlay                  = true,
     pyramiding               = 0,
     initial_capital          = 100000,
     currency                 = currency.USD,
     default_qty_type         = strategy.percent_of_equity,
     default_qty_value        = 5,
     commission_type          = strategy.commission.percent,
     commission_value         = 0.04,
     process_orders_on_close  = true,
     calc_on_every_tick       = false,
     max_labels_count         = 500)

// ============================ المدخلات ============================
grpMacd  = "MACD"
macdSrc  = input.source(close, "مصدر", group=grpMacd)
macdF    = input.int(12, "طول الخط السريع", minval=1, group=grpMacd)
macdS    = input.int(26, "بطيء", minval=1, group=grpMacd)
macdG    = input.int(9,  "Signal length", minval=1, group=grpMacd)
macdOscT = input.string("EMA", "Oscillator MA type", options=["EMA", "SMA"], group=grpMacd)
macdSigT = input.string("EMA", "Signal MA type", options=["EMA", "SMA"], group=grpMacd)

grpSmi = "Stochastic SMI (Stoch_MTM)"
smiK   = input.int(10, "Percent K Length", minval=1, group=grpSmi)
smiD   = input.int(3,  "Percent D Length", minval=1, group=grpSmi)
smiC   = input.int(10, "EMA Signal Length", minval=1, group=grpSmi)
smiSm  = input.int(1,  "Smoothing Period", minval=1, group=grpSmi)
obLvl  = input.float(40,  "تشبع شرائي", group=grpSmi)
osLvl  = input.float(-40, "تشبع بيعي", group=grpSmi)

grpSt  = "Stochastic"
stKlen = input.int(15, "طول %K", minval=1, group=grpSt)
stKsm  = input.int(3,  "تنعيم %K", minval=1, group=grpSt)
stDsm  = input.int(3,  "تنعيم %D", minval=1, group=grpSt)

grpRsi   = "RSI"
rsiLen   = input.int(14, "طول مؤشر القوى النسبية", minval=2, group=grpRsi)
rsiSrc   = input.source(close, "مصدر", group=grpRsi)
rsiMaLen = input.int(14, "طول تنعيم SMA", minval=1, group=grpRsi)

grpDon = "Donchian Trend Ribbon"
dlen   = input.int(20, "Donchian Channel Period", minval=10, group=grpDon)

grpEma = "EMA"
emaLen = input.int(50, "طول EMA", minval=1, group=grpEma)

// ============================ الحسابات ============================
f_ma(float src, simple int len, simple string typ) =>
    s = ta.sma(src, len)
    e = ta.ema(src, len)
    typ == "SMA" ? s : e

// 1) MACD
macdLine = f_ma(macdSrc, macdF, macdOscT) - f_ma(macdSrc, macdS, macdOscT)
sigLine  = f_ma(macdLine, macdG, macdSigT)
macdHist = macdLine - sigLine

// 2) Stochastic SMI — نفس معادلة Stoch_MTM (surjithctly)
ll      = ta.lowest(low, smiK)
hh      = ta.highest(high, smiK)
diff    = hh - ll
rdiff   = close - (hh + ll) / 2.0
avgrel  = ta.ema(ta.ema(rdiff, smiD), smiD)
avgdiff = ta.ema(ta.ema(diff, smiD), smiD)
smiRaw  = avgdiff != 0 ? (avgrel / (avgdiff / 2.0)) * 100.0 : 0.0
smi     = ta.sma(smiRaw, smiSm)
smiSig  = ta.ema(smi, smiC)

// 3) Stochastic
stK = ta.sma(ta.stoch(close, high, low, stKlen), stKsm)
stD = ta.sma(stK, stDsm)

// 4) RSI + تنعيم SMA
rsi   = ta.rsi(rsiSrc, rsiLen)
rsiMa = ta.sma(rsi, rsiMaLen)

// 5) Donchian Trend Ribbon — نقل حرفي لكود LonesomeTheBlue (v4 → v5)
//    dchannel(len): trend := close > hh[1] ? 1 : close < ll[1] ? -1 : nz(trend[1])
f_dchannel(simple int len) =>
    float dHH = ta.highest(high, len)
    float dLL = ta.lowest(low, len)
    var int trend = 0
    trend := close > dHH[1] ? 1 : close < dLL[1] ? -1 : trend
    trend

maintrend = f_dchannel(dlen)   // 1 = الشريط أخضر، -1 = الشريط أحمر
// الأشرطة المساعدة dlen-1..dlen-9 — في المؤشر الأصلي تتحكم بدرجة اللون فقط
// (غامق عند موافقة maintrend، فاتح عند المخالفة)
donSub1 = f_dchannel(dlen - 1)
donSub2 = f_dchannel(dlen - 2)
donSub3 = f_dchannel(dlen - 3)
donSub4 = f_dchannel(dlen - 4)
donSub5 = f_dchannel(dlen - 5)
donSub6 = f_dchannel(dlen - 6)
donSub7 = f_dchannel(dlen - 7)
donSub8 = f_dchannel(dlen - 8)
donSub9 = f_dchannel(dlen - 9)

// 6) EMA 50
ema50 = ta.ema(close, emaLen)

// ============================ العرض ============================
plot(ema50, "EMA50", color=color.new(color.blue, 0), linewidth=2)

// ============================ قواعد الدخول والخروج ============================
// بانتظار شرح صاحب الاستراتيجية — ستُضاف القواعد هنا كما يحددها بالضبط،
// بدون أي افتراضات إضافية.
