//@version=5
// Cascade 8 خطوات — زوج واحد: الشارت = الأساسي، والباقي تأكيد/دخول/إلغاء
// MACD بدون حد 40٪: شراء خط فوق الهستوجرام الأحمر | بيع خط تحت الأخضر
// الأزواج: 15/45/5 | 18/54/6 | 21/63/7 | 24/72/8 | 27/81/9 | 30/90/10
//          45/135/15 | 60/180/20 | 90/270/30 | 120/360/40 | 150/450/50
//          210/630/70 | 240/720/80 (إلغاء 240 = 300)
strategy("Cascade 8 — زوج واحد",
     overlay                  = true,
     pyramiding               = 0,
     initial_capital          = 100000,
     currency                 = currency.USD,
     default_qty_type         = strategy.percent_of_equity,
     default_qty_value        = 5,
     commission_type          = strategy.commission.percent,
     commission_value         = 0.04,
     process_orders_on_close  = true,
     calc_on_every_tick       = false,
     max_labels_count         = 500,
     max_bars_back            = 5000)

grpInd = "المؤشرات"
smiK   = input.int(10, "SMI K", minval=1, group=grpInd)
smiD   = input.int(3,  "SMI D", minval=1, group=grpInd)
osLvl  = input.float(-40, "تشبع بيعي SMI", group=grpInd)
obLvl  = input.float(40,  "تشبع شرائي SMI", group=grpInd)
macdF  = input.int(12, "MACD Fast", minval=1, group=grpInd)
macdS  = input.int(26, "MACD Slow", minval=1, group=grpInd)
macdG  = input.int(9,  "MACD Sig",  minval=1, group=grpInd)
dlen   = input.int(20, "Donchian Length", minval=2, group=grpInd)
emaLen = input.int(50, "EMA", minval=1, group=grpInd)
rsiLen = input.int(14, "RSI", minval=2, group=grpInd)
stKlen = input.int(15, "Stoch K", minval=1, group=grpInd)
stKsm  = input.int(3,  "Stoch K Smooth", minval=1, group=grpInd)
rsiOs  = input.float(35, "لمس RSI شراء", group=grpInd)
rsiOb  = input.float(65, "لمس RSI بيع", group=grpInd)
rsiConfOs = input.float(30, "RSI تأكيد ممنوع <=", group=grpInd)
rsiConfOb = input.float(70, "RSI تأكيد ممنوع >=", group=grpInd)
rsiLook   = input.int(30, "RSI تأكيد شموع", minval=1, group=grpInd)
stochBuy  = input.float(20, "Stoch شراء >", group=grpInd)
stochSell = input.float(80, "Stoch بيع <", group=grpInd)
stochGap  = input.int(3, "Stoch بعد التقاطع", minval=0, group=grpInd)

grpP = "الزوج — الشارت = الأساسي"
confirmTf = input.timeframe("180", "تأكيد ×3", group=grpP)
entryTf   = input.timeframe("20", "دخول ÷3", group=grpP)
cancelTf  = input.timeframe("90", "إلغاء (الفريم الأكبر)", group=grpP)

grpRisk = "إغلاق"
useLong = input.bool(true, "شراء", group=grpRisk)
useShrt = input.bool(true, "بيع", group=grpRisk)
usePct  = input.bool(true, "وقف/هدف %", group=grpRisk)
exitOpp = input.bool(true, "إغلاق عكسي", group=grpRisk)
histWin  = input.float(0.67, "ربح الصفقة %", step=0.01, group=grpRisk)
histLoss = input.float(0.53, "خسارة الصفقة %", step=0.01, group=grpRisk)

grpVis = "العرض"
showBg  = input.bool(true, "تظليل", group=grpVis)
showLog = input.bool(true, "لوحة الخطوات", group=grpVis)
showLbl = input.bool(true, "ملصقات الدخول", group=grpVis)

var array<int>    pTime = array.new_int()
var array<float>  pPx   = array.new_float()
var array<int>    pSide = array.new_int()
var array<string> pTag  = array.new_string()
var array<int>    hTime = array.new_int()
var array<string> hTag  = array.new_string()
var array<int>    hSide = array.new_int()
var array<int>    hWin  = array.new_int()

f_store(int et, string tag, int side, int win, float px) =>
    array.push(hTime, et)
    array.push(hTag, tag)
    array.push(hSide, side)
    array.push(hWin, win)
    if array.size(hTime) > 20
        array.shift(hTime)
        array.shift(hTag)
        array.shift(hSide)
        array.shift(hWin)
    string sideTxt = side == 1 ? "buy" : "sell"
    string winTxt = win == 1 ? "true" : "false"
    alert('{"src":"cascade","event":"result","side":"' + sideTxt + '","tag":"' + tag + '","symbol":"' + syminfo.ticker + '","price":' + str.tostring(px) + ',"win":' + winTxt + '}', alert.freq_all)

f_resolve_one(int i) =>
    int et = array.get(pTime, i)
    float px = array.get(pPx, i)
    int side = array.get(pSide, i)
    string tag = array.get(pTag, i)
    float tp = side == 1 ? px * (1.0 + histWin / 100.0) : px * (1.0 - histWin / 100.0)
    float sl = side == 1 ? px * (1.0 - histLoss / 100.0) : px * (1.0 + histLoss / 100.0)
    bool slHit = side == 1 ? low <= sl : high >= sl
    bool tpHit = side == 1 ? high >= tp : low <= tp
    int result = slHit ? 0 : tpHit ? 1 : -1
    if result >= 0
        f_store(et, tag, side, result, px)
        array.remove(pTime, i)
        array.remove(pPx, i)
        array.remove(pSide, i)
        array.remove(pTag, i)
    result

f_smi() =>
    ll = ta.lowest(low, smiK)
    hh = ta.highest(high, smiK)
    diff = hh - ll
    rdiff = close - (hh + ll) / 2.0
    avgrel = ta.ema(ta.ema(rdiff, smiD), smiD)
    avgdiff = ta.ema(ta.ema(diff, smiD), smiD)
    avgdiff != 0 ? (avgrel / (avgdiff / 2.0)) * 100.0 : 0.0

f_don() =>
    float trend = 0.0
    hh = ta.highest(high, dlen)
    ll = ta.lowest(low, dlen)
    trend := close > hh[1] ? 1.0 : close < ll[1] ? -1.0 : nz(trend[1], 0.0)
    trend

f_macd_ok(bool isLong, float smi, float hist, float macd) =>
    bool ok = false
    bool sat = isLong ? smi[1] <= osLvl : smi[1] >= obLvl
    if sat
        int off = 1
        for i = 2 to 50
            bool still = isLong ? smi[i] <= osLvl : smi[i] >= obLvl
            if not still
                break
            off := i
        float h0 = hist[off]
        float m0 = macd[off]
        if not na(h0) and not na(m0)
            ok := isLong ? (h0 < 0 and m0 >= h0) : (h0 > 0 and m0 <= h0)
    ok

f_ema_ok(bool isLong, float smi, float ema, float cl) =>
    bool found = false
    bool satNow = isLong ? smi[1] <= osLvl : smi[1] >= obLvl
    if satNow
        for i = 1 to 50
            bool sat = isLong ? smi[i] <= osLvl : smi[i] >= obLvl
            if not sat
                break
            if isLong and cl[i] < ema[i]
                found := true
                break
            if not isLong and cl[i] > ema[i]
                found := true
                break
    found

f_rsi_conf(bool isLong, float rsi) =>
    bool bad = false
    for i = 0 to rsiLook - 1
        if not na(rsi[i])
            if isLong and rsi[i] <= rsiConfOs
                bad := true
                break
            if not isLong and rsi[i] >= rsiConfOb
                bad := true
                break
    not bad

f_block(bool isLong, float smi) =>
    bool sat0 = isLong ? smi <= osLvl : smi >= obLvl
    bool blocked = sat0
    if not sat0
        int last = -1
        for i = 1 to 5
            bool s = isLong ? smi[i] <= osLvl : smi[i] >= obLvl
            if s
                last := i
                break
        blocked := last == 1 or last == 2
    blocked

f_step8(bool isLong, float smi, float rsi, float rsiMa, float k) =>
    float smiTh = isLong ? osLvl : obLvl
    float rsiTh = isLong ? rsiOs : rsiOb
    float stTh  = isLong ? stochBuy : stochSell
    bool ok = false
    int smiIdx = -1
    bool sat1 = isLong ? smi[1] <= smiTh : smi[1] >= smiTh
    if sat1
        smiIdx := 1
        for i = 2 to 60
            bool satI = isLong ? smi[i] <= smiTh : smi[i] >= smiTh
            if not satI
                break
            smiIdx := i
    else
        int lastSat = -1
        for i = 1 to 60
            bool satI = isLong ? smi[i] <= smiTh : smi[i] >= smiTh
            if satI
                lastSat := i
                break
        if lastSat > 0
            smiIdx := lastSat
            for i = lastSat + 1 to 60
                bool satI = isLong ? smi[i] <= smiTh : smi[i] >= smiTh
                if not satI
                    break
                smiIdx := i
    if smiIdx > 0
        int rsiIdx = -1
        for i = smiIdx to 1
            bool rHit = isLong ? rsi[i] <= rsiTh : rsi[i] >= rsiTh
            if rHit
                rsiIdx := i
                break
        if rsiIdx > 0
            int crossIdx = -1
            for i = rsiIdx to 1
                float prevR = rsi[i + 1]
                float prevM = rsiMa[i + 1]
                float curR  = rsi[i]
                float curM  = rsiMa[i]
                if not na(prevR) and not na(prevM) and not na(curR) and not na(curM)
                    bool crossed = isLong ? (prevR < prevM and curR >= curM) : (prevR > prevM and curR <= curM)
                    if crossed
                        crossIdx := i
                        break
            if crossIdx > 0
                int newest = math.max(1, crossIdx - stochGap)
                for j = crossIdx to newest
                    if not na(k[j])
                        bool st = isLong ? k[j] > stTh : k[j] < stTh
                        if st
                            ok := true
                            break
    ok

f_snap() =>
    smi = f_smi()
    [macdLine, sigLine, hist] = ta.macd(close, macdF, macdS, macdG)
    don = f_don()
    ema = ta.ema(close, emaLen)
    rsi = ta.rsi(close, rsiLen)
    rsiMa = ta.sma(rsi, rsiLen)
    k = ta.sma(ta.stoch(close, high, low, stKlen), stKsm)
    hist2 = hist + nz(sigLine) * 0.0
    [smi[1], don, don[1], hist2, f_macd_ok(true, smi, hist2, macdLine), f_macd_ok(false, smi, hist2, macdLine), f_ema_ok(true, smi, ema, close), f_ema_ok(false, smi, ema, close), f_rsi_conf(true, rsi), f_rsi_conf(false, rsi), f_step8(true, smi, rsi, rsiMa, k), f_step8(false, smi, rsi, rsiMa, k), f_block(true, smi), f_block(false, smi)]

f_req(simple string tf) =>
    request.security(syminfo.tickerid, tf, f_snap(), barmerge.gaps_off, barmerge.lookahead_off)

[smiB, dLB, dCB, hB, mLB, mSB, eLB, eSB, rLB, rSB, s8LB, s8SB, bLB, bSB] = f_snap()
[smiCf, dLCf, dCCf, hCf, mLCf, mSCf, eLCf, eSCf, rLCf, rSCf, s8LCf, s8SCf, bLCf, bSCf] = f_req(confirmTf)
[smiE, dLE, dCE, hE, mLE, mSE, eLE, eSE, rLE, rSE, s8LE, s8SE, bLE, bSE] = f_req(entryTf)
[smiX, dLX, dCX, hX, mLX, mSX, eLX, eSX, rLX, rSX, s8LX, s8SX, bLX, bSX] = f_req(cancelTf)

f_side(bool isLong, bool blk, float smiC, bool mOk, float donB, float donCf, float histCf, bool emaOk, bool rsiCf, float donT, bool s8) =>
    bool s1 = not blk and not na(smiC) and (isLong ? smiC <= osLvl : smiC >= obLvl)
    bool s2 = mOk
    bool s3 = isLong ? donB == 1 : donB == -1
    bool s4 = isLong ? donCf == 1 : donCf == -1
    bool s5 = isLong ? (not na(histCf) and histCf > 0) : (not na(histCf) and histCf < 0)
    bool s6 = emaOk and rsiCf
    bool s7 = isLong ? donT == -1 : donT == 1
    bool setup = s1 and s2 and s3 and s4 and s5 and s6 and s7
    bool all8 = setup and s8
    [s1, s2, s3, s4, s5, s6, s7, s8, setup, all8]

[L1, L2, L3, L4, L5, L6, L7, L8, setL, allL] = f_side(true,  bLX, smiB, mLB, dCB, dLCf, hCf, eLB, rLCf, dCE, s8LE)
[S1, S2, S3, S4, S5, S6, S7, S8, setS, allS] = f_side(false, bSX, smiB, mSB, dCB, dLCf, hCf, eSB, rSCf, dCE, s8SE)

var bool armL = true
var bool armS = true
if not setL
    armL := true
if not setS
    armS := true

hitL = useLong and allL and armL
hitS = useShrt and allS and armS
if hitL
    armL := false
if hitS
    armS := false

pairTag = timeframe.period + "/" + entryTf

int nPend = array.size(pTime)
if nPend > 0
    for i = nPend - 1 to 0
        int ignRes = f_resolve_one(i)

if hitL
    array.push(pTime, time)
    array.push(pPx, close)
    array.push(pSide, 1)
    array.push(pTag, pairTag)
    alert('{"src":"cascade","event":"entry","side":"buy","tag":"' + pairTag + '","symbol":"' + syminfo.ticker + '","price":' + str.tostring(close) + '}', alert.freq_all)
if hitS
    array.push(pTime, time)
    array.push(pPx, close)
    array.push(pSide, -1)
    array.push(pTag, pairTag)
    alert('{"src":"cascade","event":"entry","side":"sell","tag":"' + pairTag + '","symbol":"' + syminfo.ticker + '","price":' + str.tostring(close) + '}', alert.freq_all)

baseMin = timeframe.in_seconds() / 60.0
tpPct = baseMin <= 30 ? 0.67 : 1.00
slPct = baseMin <= 30 ? 0.52 : 0.75

var float longStop = na
var float longLim = na
var float shortStop = na
var float shortLim = na

if hitL
    if exitOpp and strategy.position_size < 0
        strategy.close("Short", comment="عكس")
    if strategy.position_size <= 0
        strategy.entry("Long", strategy.long, comment="شراء " + pairTag)
        longStop := close * (1.0 - slPct / 100.0)
        longLim := close * (1.0 + tpPct / 100.0)

if hitS
    if exitOpp and strategy.position_size > 0
        strategy.close("Long", comment="عكس")
    if strategy.position_size >= 0
        strategy.entry("Short", strategy.short, comment="بيع " + pairTag)
        shortStop := close * (1.0 + slPct / 100.0)
        shortLim := close * (1.0 - tpPct / 100.0)

if usePct and strategy.position_size > 0
    strategy.exit("L-Exit", from_entry="Long", stop=longStop, limit=longLim)
if usePct and strategy.position_size < 0
    strategy.exit("S-Exit", from_entry="Short", stop=shortStop, limit=shortLim)

f_mark(bool v) => v ? "1" : ""

if showLbl
    if hitL
        label.new(bar_index, low, "B " + pairTag, style=label.style_label_up, color=color.lime, textcolor=color.black, size=size.small)
    if hitS
        label.new(bar_index, high, "S " + pairTag, style=label.style_label_down, color=color.red, textcolor=color.white, size=size.small)

bgcolor(showBg and (setL or setS) ? color.new(color.gray, 92) : na)
plotshape(hitL, title="شراء", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.tiny)
plotshape(hitS, title="بيع", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.tiny)

var label logLbl = label.new(bar_index, high, "", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, color=color.new(#111111, 5), textcolor=color.white, size=size.small, textalign=text.align_left)

if showLog
    string txt = "Cascade زوج واحد | " + timeframe.period + " / " + confirmTf + " / " + entryTf + "\n"
    txt += "إلغاء " + cancelTf + " | الأرقام=خطوات OK\n"
    txt += "B" + f_mark(L1) + f_mark(L2) + f_mark(L3) + f_mark(L4) + f_mark(L5) + f_mark(L6) + f_mark(L7) + f_mark(L8)
    txt += "  S" + f_mark(S1) + f_mark(S2) + f_mark(S3) + f_mark(S4) + f_mark(S5) + f_mark(S6) + f_mark(S7) + f_mark(S8)
    label.set_xy(logLbl, bar_index, high)
    label.set_text(logLbl, txt)
else
    label.set_text(logLbl, "")

alertcondition(hitL, title="شراء", message="Cascade شراء")
alertcondition(hitS, title="بيع", message="Cascade بيع")
