//@version=5
// Cascade 8 خطوات — زوج 15د ملغى. الشارت 5م أو أقل (الدقيقة أفضل) حتى تظهر مداخل 5م.
// وقف/هدف: أقل من 2س = 2٪/2٪ | من 2س إلى اليوم = وقف 3٪ هدف 4٪.
// الإلغاء: كل رئيس يلغي الأصغر منه من 15م إلى 4س. 4س يلغيه 5س. 1ي←2ي←3ي←4ي.
// الحظر يرتفع فور خروج SMI الأب من ±40 (بدون سماحية 1–2 شمعة).
// request.security على فريم أدنى ترجع آخر شمعة فقط. security_lower_tf لا تُستخدم.
// step8 فقط على فريمات الدخول. 6 EMA ثم 7 Donchian الدخول ثم 8 — تسلسل، مو مع بعض.
// شرط 4 (Donchian التأكيد) ملغى ولا يدخل في قرار الصفقة.
// شرط 5: ROC التأكيد (EMA للـ ROC بطول 48). الخط السميك فوق 0 شراء | تحت 0 بيع. MACD التأكيد أُزيل.
// شرط 6 RSI: تأكيد شراء 50–60 | تأكيد بيع 40–50. التأكيد أعلى من الرئيس بفرق 3–10 (الشراء والبيع).
// Donchian بـ var حتى يثبت عبر استدعاءات security.
// MACD: بعد أول تشبع انتظر. أقصى موجة من آخر 24س (فريم < 1س) أو 72س فعلية (1س فأعلى). شراء خط فوق الأحمر وتحت 20٪ | بيع تحت الأخضر وفوق 20٪. يثبت جاهز حتى الدخول أو نهاية التشبع.
// تنبيه تلقرام: أنشئ Alert → Any alert() function call → Webhook /tv?token=SECRET
// النتائج على الشارت: عدّاد ناجحة/فاشلة + RSI وإغلاق الرئيس والتأكيد لكل صفقة.
// صفحة النتائج من الإعدادات (20 صفقة في الصفحة، يُحفظ آخر 100).
strategy("Cascade 8 — فريمات د/س/ي",
     overlay                  = true,
     pyramiding               = 0,
     initial_capital          = 100000,
     currency                 = currency.USD,
     default_qty_type         = strategy.percent_of_equity,
     default_qty_value        = 2,
     commission_type          = strategy.commission.percent,
     commission_value         = 0.04,
     process_orders_on_close  = true,
     calc_on_every_tick       = false,
     max_labels_count         = 500,
     max_bars_back            = 1000)

grpInd = "المؤشرات"
smiK   = input.int(10, "SMI K", minval=1, group=grpInd)
smiD   = input.int(3,  "SMI D", minval=1, group=grpInd)
osLvl  = input.float(-40, "تشبع بيعي SMI", group=grpInd)
obLvl  = input.float(40,  "تشبع شرائي SMI", group=grpInd)
macdF  = input.int(12, "MACD Fast", minval=1, group=grpInd)
macdS  = input.int(26, "MACD Slow", minval=1, group=grpInd)
macdG  = input.int(9,  "MACD Sig",  minval=1, group=grpInd)
macdPct = input.float(20.0, "سقف/أرضية خط MACD ٪", minval=0, maxval=100, step=1, group=grpInd)
rocLen = input.int(48, "ROC طول", minval=1, group=grpInd)
dlen   = input.int(20, "Donchian Length", minval=2, group=grpInd)
emaLen = input.int(50, "EMA", minval=1, group=grpInd)
rsiLen = input.int(14, "RSI", minval=2, group=grpInd)
stKlen = input.int(15, "Stoch K", minval=1, group=grpInd)
stKsm  = input.int(3,  "Stoch K Smooth", minval=1, group=grpInd)
rsiOs  = input.float(35, "لمس RSI شراء", group=grpInd)
rsiOb  = input.float(65, "لمس RSI بيع", group=grpInd)
rsiConfOs = input.float(30, "RSI تأكيد ممنوع <=", group=grpInd)
rsiConfOb = input.float(70, "RSI تأكيد ممنوع >=", group=grpInd)
rsiLook   = input.int(30, "RSI تأكيد شموع", minval=1, group=grpInd)
rsiCfBuyLo  = input.float(50.0, "RSI تأكيد شراء من", group=grpInd)
rsiCfBuyHi  = input.float(60.0, "RSI تأكيد شراء إلى", group=grpInd)
rsiCfSellLo = input.float(40.0, "RSI تأكيد بيع من", group=grpInd)
rsiCfSellHi = input.float(50.0, "RSI تأكيد بيع إلى", group=grpInd)
rsiSpreadMin = input.float(3.0, "فرق RSI رئيس من", group=grpInd)
rsiSpreadMax = input.float(10.0, "فرق RSI رئيس إلى", group=grpInd)
stochBuy  = input.float(20, "Stoch شراء >", group=grpInd)
stochSell = input.float(80, "Stoch بيع <", group=grpInd)
stochGap  = input.int(3, "Stoch بعد التقاطع", minval=0, group=grpInd)

grpP = "الأزواج"
use15  = input.bool(false, "15د / 45د / 5د — ملغى", group=grpP)
use30  = input.bool(true, "30د / 90د / 10د", group=grpP)
use45  = input.bool(true, "45د / 135د / 15د", group=grpP)
use60  = input.bool(true, "1س / 3س / 20د", group=grpP)
use90  = input.bool(true, "90د / 270د / 30د", group=grpP)
use120 = input.bool(true, "2س / 6س / 40د", group=grpP)
use150 = input.bool(true, "150د / 450د / 50د", group=grpP)
use180 = input.bool(true, "3س / 9س / 1س", group=grpP)
use210 = input.bool(true, "210د / 630د / 70د", group=grpP)
use240 = input.bool(true, "4س / 12س / 80د", group=grpP)
useD1  = input.bool(true, "1ي / 3ي / 2س", group=grpP)
useD2  = input.bool(true, "2ي / 6ي / 4س", group=grpP)
useD3  = input.bool(true, "3ي / 9ي / 1ي", group=grpP)

grpRisk = "إغلاق"
useLong = input.bool(true, "شراء", group=grpRisk)
useShrt = input.bool(true, "بيع", group=grpRisk)
usePct  = input.bool(true, "وقف/هدف %", group=grpRisk)
exitOpp = input.bool(true, "إغلاق عكسي", group=grpRisk)

grpVis = "العرض"
showBg  = input.bool(true, "تظليل", group=grpVis)
showLog = input.bool(true, "لوحة كل الفريمات", group=grpVis)
showLbl = input.bool(true, "ملصقات الدخول", group=grpVis)
showScore = input.bool(true, "نتائج الصفقات + RSI", group=grpVis)
scorePage = input.int(1, "صفحة النتائج", minval=1, group=grpVis)
histWin  = input.float(2.00, "ربح أقل من 2س %", step=0.01, group=grpVis)
histLoss = input.float(2.00, "خسارة أقل من 2س %", step=0.01, group=grpVis)
htfWin   = input.float(4.00, "ربح 2س–يوم %", step=0.01, group=grpVis)
htfLoss  = input.float(3.00, "خسارة 2س–يوم %", step=0.01, group=grpVis)
histKeep = 100
pageSize = 20

var array<int>    pTime = array.new_int()
var array<float>  pPx   = array.new_float()
var array<int>    pSide = array.new_int()
var array<string> pTag  = array.new_string()
var array<float>  pRsiM = array.new_float()
var array<float>  pRsiC = array.new_float()
var array<float>  pClM  = array.new_float()
var array<float>  pClC  = array.new_float()
var array<float>  pTpPct = array.new_float()
var array<float>  pSlPct = array.new_float()
var array<int>    hTime = array.new_int()
var array<string> hTag  = array.new_string()
var array<int>    hSide = array.new_int()
var array<int>    hWin  = array.new_int()
var array<float>  hRsiM = array.new_float()
var array<float>  hRsiC = array.new_float()
var array<float>  hClM  = array.new_float()
var array<float>  hClC  = array.new_float()
var array<int>    tally = array.new_int(2, 0)
var int firstBarTime = time

f_rsi_txt(float v) =>
    na(v) ? "—" : str.tostring(v, "#.#")

f_px_txt(float v) =>
    na(v) ? "—" : str.tostring(v, format.mintick)

f_pair_txt(float rsi, float cl) =>
    "RSI " + f_rsi_txt(rsi) + "\nإغلاق " + f_px_txt(cl)

// 2س / 150د / 3س / 210د / 4س / 1ي / 2ي / 3ي → ربح 4٪ وقف 3٪
f_wide_tf(string tag) =>
    tag == "2س/40" or tag == "150/50" or tag == "3س/1س" or tag == "210/70" or tag == "4س/80" or tag == "1ي/2س" or tag == "2ي/4س" or tag == "3ي/1ي"

f_tp_pct(string tag) => f_wide_tf(tag) ? htfWin : histWin
f_sl_pct(string tag) => f_wide_tf(tag) ? htfLoss : histLoss

f_score_json() =>
    '"wins":' + str.tostring(array.get(tally, 0)) + ',"losses":' + str.tostring(array.get(tally, 1)) + ',"open":' + str.tostring(array.size(pTime))

f_store(int et, string tag, int side, int win, float px, float rsiM, float rsiC, float clM, float clC) =>
    array.push(hTime, et)
    array.push(hTag, tag)
    array.push(hSide, side)
    array.push(hWin, win)
    array.push(hRsiM, rsiM)
    array.push(hRsiC, rsiC)
    array.push(hClM, clM)
    array.push(hClC, clC)
    if array.size(hTime) > histKeep
        array.shift(hTime)
        array.shift(hTag)
        array.shift(hSide)
        array.shift(hWin)
        array.shift(hRsiM)
        array.shift(hRsiC)
        array.shift(hClM)
        array.shift(hClC)
    int tIdx = win == 1 ? 0 : 1
    array.set(tally, tIdx, array.get(tally, tIdx) + 1)
    string sideTxt = side == 1 ? "buy" : "sell"
    string winTxt = win == 1 ? "true" : "false"
    alert('{"src":"cascade","event":"result","side":"' + sideTxt + '","tag":"' + tag + '","symbol":"' + syminfo.ticker + '","price":' + str.tostring(px) + ',"win":' + winTxt + ',"rsi_main":' + str.tostring(rsiM) + ',"rsi_confirm":' + str.tostring(rsiC) + ',"close_main":' + str.tostring(clM) + ',"close_confirm":' + str.tostring(clC) + ',' + f_score_json() + '}', alert.freq_all)

f_resolve_one(int i) =>
    int et = array.get(pTime, i)
    float px = array.get(pPx, i)
    int side = array.get(pSide, i)
    string tag = array.get(pTag, i)
    float rsiM = array.get(pRsiM, i)
    float rsiC = array.get(pRsiC, i)
    float clM = array.get(pClM, i)
    float clC = array.get(pClC, i)
    float tpPct = array.get(pTpPct, i)
    float slPct = array.get(pSlPct, i)
    float tp = side == 1 ? px * (1.0 + tpPct / 100.0) : px * (1.0 - tpPct / 100.0)
    float sl = side == 1 ? px * (1.0 - slPct / 100.0) : px * (1.0 + slPct / 100.0)
    bool slHit = side == 1 ? low <= sl : high >= sl
    bool tpHit = side == 1 ? high >= tp : low <= tp
    int result = slHit ? 0 : tpHit ? 1 : -1
    if result >= 0
        f_store(et, tag, side, result, px, rsiM, rsiC, clM, clC)
        array.remove(pTime, i)
        array.remove(pPx, i)
        array.remove(pSide, i)
        array.remove(pTag, i)
        array.remove(pRsiM, i)
        array.remove(pRsiC, i)
        array.remove(pClM, i)
        array.remove(pClC, i)
        array.remove(pTpPct, i)
        array.remove(pSlPct, i)
    result

f_track(bool hit, int side, string tag, float rsiM, float rsiC, float clM, float clC) =>
    bool done = false
    if hit
        array.push(pTime, time)
        array.push(pPx, close)
        array.push(pSide, side)
        array.push(pTag, tag)
        array.push(pRsiM, rsiM)
        array.push(pRsiC, rsiC)
        array.push(pClM, clM)
        array.push(pClC, clC)
        array.push(pTpPct, f_tp_pct(tag))
        array.push(pSlPct, f_sl_pct(tag))
        string sideTxt = side == 1 ? "buy" : "sell"
        alert('{"src":"cascade","event":"entry","side":"' + sideTxt + '","tag":"' + tag + '","symbol":"' + syminfo.ticker + '","price":' + str.tostring(close) + ',"rsi_main":' + str.tostring(rsiM) + ',"rsi_confirm":' + str.tostring(rsiC) + ',"close_main":' + str.tostring(clM) + ',"close_confirm":' + str.tostring(clC) + '}', alert.freq_all)
        done := true
    done

f_smi() =>
    ll = ta.lowest(low, smiK)
    hh = ta.highest(high, smiK)
    diff = hh - ll
    rdiff = close - (hh + ll) / 2.0
    avgrel = ta.ema(ta.ema(rdiff, smiD), smiD)
    avgdiff = ta.ema(ta.ema(diff, smiD), smiD)
    avgdiff != 0 ? (avgrel / (avgdiff / 2.0)) * 100.0 : 0.0

f_don() =>
    var float trend = 0.0
    hh = ta.highest(high, dlen)
    ll = ta.lowest(low, dlen)
    trend := close > hh[1] ? 1.0 : close < ll[1] ? -1.0 : trend
    trend

// ROC ثم متوسطه: (close-close[n])/close[n]*100 ثم EMA(n). الإشارة من الخط السميك مقابل 0.
f_maroc() =>
    float prev = close[rocLen]
    float roc = prev != 0 ? (close - prev) / prev * 100.0 : 0.0
    ta.ema(roc, rocLen)

// بعد أول تشبع لا يُرفض فورًا. ينتظر حتى يصل الخط إلى 20٪ من أقصى موجة، ثم يثبت جاهز.
f_macd_ok(bool isLong, float smi, float hist, float macd) =>
    var bool ready = false
    bool satNow = isLong ? smi[1] <= osLvl : smi[1] >= obLvl
    if not satNow
        ready := false
    else if not ready
        int off = 1
        for i = 2 to 50
            bool still = isLong ? smi[i] <= osLvl : smi[i] >= obLvl
            if not still
                break
            off := i
        int barSec = int(math.max(1, (time - time[1]) / 1000))
        int winHours = barSec < 3600 ? 24 : 72
        int winBars = int(math.max(2, math.round(winHours * 3600.0 / barSec)))
        if winBars > 300
            winBars := 300
        float bound = 0.0
        for j = 1 to winBars
            float v = macd[j]
            if not na(v)
                if isLong and v > 0 and v > bound
                    bound := v
                if not isLong and v < 0 and v < bound
                    bound := v
        float cap = bound * (macdPct / 100.0)
        for i = off to 1
            float h0 = hist[i]
            float m0 = macd[i]
            if not na(h0) and not na(m0)
                bool sideOk = isLong ? (h0 < 0 and m0 >= h0) : (h0 > 0 and m0 <= h0)
                bool distOk = isLong ? m0 <= cap : m0 >= cap
                if sideOk and distOk
                    ready := true
                    break
    ready

// أول وقت (أقدم شمعة) أغلق ضد EMA50 داخل موجة تشبع الرئيس الحالية.
f_ema_ok(bool isLong, float smi, float ema, float cl) =>
    var int hit = na
    bool satNow = isLong ? smi[1] <= osLvl : smi[1] >= obLvl
    if not satNow
        hit := na
    else if na(hit)
        int off = 1
        for i = 2 to 50
            bool sat = isLong ? smi[i] <= osLvl : smi[i] >= obLvl
            if not sat
                break
            off := i
        for i = off to 1
            if isLong and cl[i] < ema[i]
                hit := time[i]
                break
            if not isLong and cl[i] > ema[i]
                hit := time[i]
                break
    hit

f_rsi_conf(bool isLong, float rsi) =>
    bool bad = false
    for i = 0 to rsiLook - 1
        if not na(rsi[i])
            if isLong and rsi[i] <= rsiConfOs
                bad := true
                break
            if not isLong and rsi[i] >= rsiConfOb
                bad := true
                break
    not bad

// تأكيد شراء 50.00–60.00 | بيع 40.00–50.00 (50.01 و 39.99 مرفوضان للبيع).
f_rsi_band(bool isLong, float rsiC) =>
    not na(rsiC) and (isLong ? (rsiC >= rsiCfBuyLo and rsiC <= rsiCfBuyHi) : (rsiC >= rsiCfSellLo and rsiC <= rsiCfSellHi))

// التأكيد أعلى من الرئيس بـ 3–10 في الشراء والبيع. شراء: الرئيس أدنى. بيع: التأكيد أعلى.
f_rsi_gap(float rsiM, float rsiC) =>
    not na(rsiM) and not na(rsiC) and (rsiC - rsiM >= rsiSpreadMin and rsiC - rsiM <= rsiSpreadMax)

f_block(bool isLong, float smi) =>
    isLong ? smi <= osLvl : smi >= obLvl

f_step8(bool isLong, float smi, float rsi, float rsiMa, float k) =>
    float smiTh = isLong ? osLvl : obLvl
    float rsiTh = isLong ? rsiOs : rsiOb
    float stTh  = isLong ? stochBuy : stochSell
    int done = na
    int smiIdx = -1
    bool sat1 = isLong ? smi[1] <= smiTh : smi[1] >= smiTh
    if sat1
        smiIdx := 1
        for i = 2 to 60
            bool satI = isLong ? smi[i] <= smiTh : smi[i] >= smiTh
            if not satI
                break
            smiIdx := i
    else
        int lastSat = -1
        for i = 1 to 60
            bool satI = isLong ? smi[i] <= smiTh : smi[i] >= smiTh
            if satI
                lastSat := i
                break
        if lastSat > 0
            smiIdx := lastSat
            for i = lastSat + 1 to 60
                bool satI = isLong ? smi[i] <= smiTh : smi[i] >= smiTh
                if not satI
                    break
                smiIdx := i
    if smiIdx > 0
        int rsiIdx = -1
        for i = smiIdx to 1
            bool rHit = isLong ? rsi[i] <= rsiTh : rsi[i] >= rsiTh
            if rHit
                rsiIdx := i
                break
        if rsiIdx > 0
            int crossIdx = -1
            for i = rsiIdx to 1
                float prevR = rsi[i + 1]
                float prevM = rsiMa[i + 1]
                float curR  = rsi[i]
                float curM  = rsiMa[i]
                if not na(prevR) and not na(prevM) and not na(curR) and not na(curM)
                    bool crossed = isLong ? (prevR < prevM and curR >= curM) : (prevR > prevM and curR <= curM)
                    if crossed
                        crossIdx := i
                        break
            if crossIdx > 0
                int newest = math.max(1, crossIdx - stochGap)
                for j = crossIdx to newest
                    if not na(k[j])
                        bool st = isLong ? k[j] > stTh : k[j] < stTh
                        if st
                            done := time[j]
                            break
    done

// security على فريم أدنى من الشارت ترجع آخر شمعة فقط (مو كل na).
// security_lower_tf تلقط كل الشموع داخل الساعة، لكن تنهار مع 36 فريم (حد 40 طلب) وتفشل إذا الشارت أصغر من المطلوب.
f_snap_entry() =>
    smi = f_smi()
    don = f_don()
    rsi = ta.rsi(close, rsiLen)
    rsiMa = ta.sma(rsi, rsiLen)
    k = ta.sma(ta.stoch(close, high, low, stKlen), stKsm)
    [don[1], f_step8(true, smi, rsi, rsiMa, k), f_step8(false, smi, rsi, rsiMa, k), time[1]]

f_snap_confirm() =>
    don = f_don()
    rsi = ta.rsi(close, rsiLen)
    rocMa = f_maroc()
    [don, rocMa, f_rsi_conf(true, rsi), f_rsi_conf(false, rsi), rsi, close[1]]

f_snap_base() =>
    smi = f_smi()
    [macdLine, sigLine, hist] = ta.macd(close, macdF, macdS, macdG)
    don = f_don()
    ema = ta.ema(close, emaLen)
    rsi = ta.rsi(close, rsiLen)
    hist2 = hist + nz(sigLine) * 0.0
    [smi[1], don[1], f_macd_ok(true, smi, hist2, macdLine), f_macd_ok(false, smi, hist2, macdLine), f_ema_ok(true, smi, ema, close), f_ema_ok(false, smi, ema, close), f_block(true, smi), f_block(false, smi), rsi, close[1]]

f_snap_cancel() =>
    smi = f_smi()
    [f_block(true, smi), f_block(false, smi)]

f_snap_base_entry() =>
    smi = f_smi()
    [macdLine, sigLine, hist] = ta.macd(close, macdF, macdS, macdG)
    don = f_don()
    ema = ta.ema(close, emaLen)
    rsi = ta.rsi(close, rsiLen)
    rsiMa = ta.sma(rsi, rsiLen)
    k = ta.sma(ta.stoch(close, high, low, stKlen), stKsm)
    hist2 = hist + nz(sigLine) * 0.0
    [smi[1], don[1], f_macd_ok(true, smi, hist2, macdLine), f_macd_ok(false, smi, hist2, macdLine), f_ema_ok(true, smi, ema, close), f_ema_ok(false, smi, ema, close), f_step8(true, smi, rsi, rsiMa, k), f_step8(false, smi, rsi, rsiMa, k), f_block(true, smi), f_block(false, smi), rsi, time[1], close[1]]

f_snap_htf() =>
    smi = f_smi()
    [macdLine, sigLine, hist] = ta.macd(close, macdF, macdS, macdG)
    don = f_don()
    ema = ta.ema(close, emaLen)
    rsi = ta.rsi(close, rsiLen)
    hist2 = hist + nz(sigLine) * 0.0
    rocMa = f_maroc()
    [smi[1], don, don[1], rocMa, f_macd_ok(true, smi, hist2, macdLine), f_macd_ok(false, smi, hist2, macdLine), f_ema_ok(true, smi, ema, close), f_ema_ok(false, smi, ema, close), f_rsi_conf(true, rsi), f_rsi_conf(false, rsi), f_block(true, smi), f_block(false, smi), rsi, close[1]]

f_req_entry(simple string tf) =>
    request.security(syminfo.tickerid, tf, f_snap_entry(), barmerge.gaps_off, barmerge.lookahead_off)

f_req_confirm(simple string tf) =>
    request.security(syminfo.tickerid, tf, f_snap_confirm(), barmerge.gaps_off, barmerge.lookahead_off)

f_req_base(simple string tf) =>
    request.security(syminfo.tickerid, tf, f_snap_base(), barmerge.gaps_off, barmerge.lookahead_off)

f_req_cancel(simple string tf) =>
    request.security(syminfo.tickerid, tf, f_snap_cancel(), barmerge.gaps_off, barmerge.lookahead_off)

f_req_base_entry(simple string tf) =>
    request.security(syminfo.tickerid, tf, f_snap_base_entry(), barmerge.gaps_off, barmerge.lookahead_off)

f_req_htf(simple string tf) =>
    request.security(syminfo.tickerid, tf, f_snap_htf(), barmerge.gaps_off, barmerge.lookahead_off)

