//@version=5
// استراتيجية جديدة — 6 مؤشرات على فريم الشارت. شمعة مغلقة فقط.
// MACD: إغلاق، 12/26/9، EMA/EMA، انتظر إغلاق الفريم.
// SMI / Stoch_MTM (surjithctly): K=10، D=3، إشارة EMA=10، تمهيد=1، تشبع +40 / −40.
// Stochastic: 14 / 3 / 3 (الإعداد الافتراضي في TradingView — غيّره من المدخلات).
// RSI: 14.
// Donchian Trend Ribbon (LonesomeTheBlue): فترة 20. الاتجاه = العمود الرئيسي.
// EMA 50.
//
// شراء (كلّها على إغلاق): Donchian أخضر + إغلاق فوق EMA50 + هستوجرام MACD > 0
//   + SMI يقطع إشارته للأعلى بعد لمس −40 + RSI > 50 + Stoch %K يقطع %D للأعلى.
// بيع: العكس (+40، تحت EMA50، هستوجرام < 0، RSI < 50، %K يقطع %D للأسفل).
strategy("S6 — 6 مؤشرات",
     overlay                 = true,
     pyramiding              = 0,
     initial_capital         = 100000,
     currency                = currency.USD,
     default_qty_type        = strategy.percent_of_equity,
     default_qty_value       = 2,
     commission_type         = strategy.commission.percent,
     commission_value        = 0.04,
     process_orders_on_close = true,
     calc_on_every_tick      = false,
     max_labels_count        = 200)

grpM = "MACD"
macdSrc = input.source(close, "مصدر", group=grpM)
macdF   = input.int(12, "طول الخط السريع", minval=1, group=grpM)
macdS   = input.int(26, "بطيء", minval=1, group=grpM)
macdG   = input.int(9,  "طول الإشارة", minval=1, group=grpM)

grpSmi = "SMI / Stoch_MTM"
smiK     = input.int(10, "Percent K Length", minval=1, group=grpSmi)
smiD     = input.int(3,  "Percent D Length", minval=1, group=grpSmi)
smiEma   = input.int(10, "EMA Signal Length", minval=1, group=grpSmi)
smiSm    = input.int(1,  "Smoothing Period", minval=1, group=grpSmi)
smiOb    = input.float(40,  "تشبع شرائي", group=grpSmi)
smiOs    = input.float(-40, "تشبع بيعي", group=grpSmi)

grpSt = "Stochastic"
stKlen = input.int(14, "%K Length", minval=1, group=grpSt)
stKsm  = input.int(3,  "%K Smoothing", minval=1, group=grpSt)
stDsm  = input.int(3,  "%D Smoothing", minval=1, group=grpSt)

grpR = "RSI"
rsiLen = input.int(14, "RSI Length", minval=2, group=grpR)
rsiMid = input.float(50, "خط المنتصف", group=grpR)

grpD = "Donchian Trend Ribbon"
dlen = input.int(20, "Donchian Channel Period", minval=10, group=grpD)

grpE = "EMA"
emaLen = input.int(50, "EMA", minval=1, group=grpE)

grpX = "إغلاق"
useLong = input.bool(true, "شراء", group=grpX)
useShrt = input.bool(true, "بيع", group=grpX)
usePct  = input.bool(true, "وقف/هدف %", group=grpX)
tpPct   = input.float(2.0, "هدف %", step=0.1, group=grpX)
slPct   = input.float(2.0, "وقف %", step=0.1, group=grpX)

grpV = "عرض"
showEma  = input.bool(true, "رسم EMA", group=grpV)
showTbl  = input.bool(true, "لوحة الشروط", group=grpV)

// 1) MACD — EMA / EMA على الإغلاق.
[macdLine, macdSig, macdHist] = ta.macd(macdSrc, macdF, macdS, macdG)

// 2) SMI / Stoch_MTM — ويليام بلاو + تمهيد ثم إشارة EMA.
f_smi() =>
    ll = ta.lowest(low, smiK)
    hh = ta.highest(high, smiK)
    diff = hh - ll
    rdiff = close - (hh + ll) / 2.0
    avgrel = ta.ema(ta.ema(rdiff, smiD), smiD)
    avgdiff = ta.ema(ta.ema(diff, smiD), smiD)
    raw = avgdiff != 0 ? (avgrel / (avgdiff / 2.0)) * 100.0 : 0.0
    sm = ta.sma(raw, smiSm)
    sig = ta.ema(sm, smiEma)
    [sm, sig]

[smi, smiSig] = f_smi()

// 3) Stochastic البطيء.
stochK = ta.sma(ta.stoch(close, high, low, stKlen), stKsm)
stochD = ta.sma(stochK, stDsm)

// 4) RSI.
rsi = ta.rsi(close, rsiLen)

// 5) Donchian Trend Ribbon — نفس dchannel في سكربت LonesomeTheBlue.
f_don(int len) =>
    hh = ta.highest(high, len)
    ll = ta.lowest(low, len)
    var int trend = 0
    trend := close > hh[1] ? 1 : close < ll[1] ? -1 : trend
    trend

don = f_don(dlen)

// 6) EMA 50.
ema = ta.ema(close, emaLen)

// process_orders_on_close = true → هذه الشمعة مغلقة. لا نأخذ [1].
macdBuy  = macdHist > 0
macdSell = macdHist < 0
smiCrossUp   = smi > smiSig and smi[1] <= smiSig[1]
smiCrossDown = smi < smiSig and smi[1] >= smiSig[1]
smiOsTouch = ta.lowest(smi, 8) <= smiOs
smiObTouch = ta.highest(smi, 8) >= smiOb
smiBuy  = smiCrossUp and smiOsTouch
smiSell = smiCrossDown and smiObTouch
stochBuy  = stochK > stochD and stochK[1] <= stochD[1]
stochSell = stochK < stochD and stochK[1] >= stochD[1]
rsiBuy  = rsi > rsiMid
rsiSell = rsi < rsiMid
donBuy  = don == 1
donSell = don == -1
emaBuy  = close > ema
emaSell = close < ema

buyHit  = useLong and macdBuy and smiBuy and stochBuy and rsiBuy and donBuy and emaBuy
sellHit = useShrt and macdSell and smiSell and stochSell and rsiSell and donSell and emaSell

var float longStop = na
var float longLim  = na
var float shortStop = na
var float shortLim  = na

if buyHit
    if strategy.position_size < 0
        strategy.close("Short", comment="عكس")
    if strategy.position_size <= 0
        strategy.entry("Long", strategy.long, comment="شراء")
        longStop := close * (1.0 - slPct / 100.0)
        longLim  := close * (1.0 + tpPct / 100.0)

if sellHit
    if strategy.position_size > 0
        strategy.close("Long", comment="عكس")
    if strategy.position_size >= 0
        strategy.entry("Short", strategy.short, comment="بيع")
        shortStop := close * (1.0 + slPct / 100.0)
        shortLim  := close * (1.0 - tpPct / 100.0)

if usePct and strategy.position_size > 0
    strategy.exit("L-Exit", from_entry="Long", stop=longStop, limit=longLim)
if usePct and strategy.position_size < 0
    strategy.exit("S-Exit", from_entry="Short", stop=shortStop, limit=shortLim)

plot(showEma ? ema : na, "EMA50", color=color.orange, linewidth=2)
barcolor(don == 1 ? color.new(color.green, 70) : don == -1 ? color.new(color.red, 70) : na)
plotshape(buyHit,  title="شراء", style=shape.triangleup,   location=location.belowbar, color=color.lime, size=size.small)
plotshape(sellHit, title="بيع",  style=shape.triangledown, location=location.abovebar, color=color.red,  size=size.small)

f_mark(bool v) => v ? "✓" : "—"

var table box = table.new(position.top_left, 3, 8, bgcolor=color.new(#141414, 8), border_width=1, border_color=color.new(#555555, 0))
var bool boxMerged = false
if not boxMerged
    table.merge_cells(box, 0, 7, 2, 7)
    boxMerged := true
if barstate.islast and showTbl
    hd = color.new(#1b3a5c, 0)
    bg = color.new(#1a1a1a, 0)
    table.cell(box, 0, 0, "المؤشر", text_color=color.white, bgcolor=hd, text_size=size.small)
    table.cell(box, 1, 0, "شراء", text_color=color.white, bgcolor=hd, text_size=size.small)
    table.cell(box, 2, 0, "بيع", text_color=color.white, bgcolor=hd, text_size=size.small)
    table.cell(box, 0, 1, "MACD", text_color=color.silver, bgcolor=bg, text_size=size.small)
    table.cell(box, 1, 1, f_mark(macdBuy), text_color=macdBuy ? color.lime : color.gray, bgcolor=bg, text_size=size.small)
    table.cell(box, 2, 1, f_mark(macdSell), text_color=macdSell ? color.red : color.gray, bgcolor=bg, text_size=size.small)
    table.cell(box, 0, 2, "SMI", text_color=color.silver, bgcolor=bg, text_size=size.small)
    table.cell(box, 1, 2, f_mark(smiBuy), text_color=smiBuy ? color.lime : color.gray, bgcolor=bg, text_size=size.small)
    table.cell(box, 2, 2, f_mark(smiSell), text_color=smiSell ? color.red : color.gray, bgcolor=bg, text_size=size.small)
    table.cell(box, 0, 3, "Stoch", text_color=color.silver, bgcolor=bg, text_size=size.small)
    table.cell(box, 1, 3, f_mark(stochBuy), text_color=stochBuy ? color.lime : color.gray, bgcolor=bg, text_size=size.small)
    table.cell(box, 2, 3, f_mark(stochSell), text_color=stochSell ? color.red : color.gray, bgcolor=bg, text_size=size.small)
    table.cell(box, 0, 4, "RSI", text_color=color.silver, bgcolor=bg, text_size=size.small)
    table.cell(box, 1, 4, f_mark(rsiBuy), text_color=rsiBuy ? color.lime : color.gray, bgcolor=bg, text_size=size.small)
    table.cell(box, 2, 4, f_mark(rsiSell), text_color=rsiSell ? color.red : color.gray, bgcolor=bg, text_size=size.small)
    table.cell(box, 0, 5, "Donchian", text_color=color.silver, bgcolor=bg, text_size=size.small)
    table.cell(box, 1, 5, f_mark(donBuy), text_color=donBuy ? color.lime : color.gray, bgcolor=bg, text_size=size.small)
    table.cell(box, 2, 5, f_mark(donSell), text_color=donSell ? color.red : color.gray, bgcolor=bg, text_size=size.small)
    table.cell(box, 0, 6, "EMA50", text_color=color.silver, bgcolor=bg, text_size=size.small)
    table.cell(box, 1, 6, f_mark(emaBuy), text_color=emaBuy ? color.lime : color.gray, bgcolor=bg, text_size=size.small)
    table.cell(box, 2, 6, f_mark(emaSell), text_color=emaSell ? color.red : color.gray, bgcolor=bg, text_size=size.small)
    table.cell(box, 0, 7, "SMI " + str.tostring(smi, "#.#") + "  RSI " + str.tostring(rsi, "#.#") + "  K " + str.tostring(stochK, "#.#"), text_color=color.white, bgcolor=hd, text_size=size.small)

alertcondition(buyHit,  title="شراء", message="S6 شراء")
alertcondition(sellHit, title="بيع",  message="S6 بيع")
