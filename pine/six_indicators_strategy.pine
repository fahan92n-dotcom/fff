//@version=5
// استراتيجية 6 مؤشرات — تنفيذ حرفي لشرح صاحب الاستراتيجية (شراء وبيع).
//
// الأزواج العشرة (الرئيس | التأكيد | الدخول) بالدقائق — التأكيد = 3× الرئيس، الدخول = ثلث الرئيس:
//    1) 15  | 45  | 5        6) 120 | 360 | 40
//    2) 30  | 90  | 10       7) 150 | 450 | 50
//    3) 45  | 135 | 15       8) 180 | 540 | 60
//    4) 60  | 180 | 20       9) 210 | 630 | 70
//    5) 90  | 270 | 30      10) 240 | 720 | 80
//
// قاعدة الإلغاء: حينما يغلق تشبّع (بنفس الاتجاه) على الفريم الرئيس الأكبر يُلغى تسلسل
// الفريم الرئيس الأصغر منه: إغلاق 30 يلغي 15، إغلاق 45 يلغي 30... وأكبر فريم (240=4س)
// يُلغى بإغلاق تشبّع على 300 (5س).
//
// الشروط التسعة — تسلسلية: كل شرط «يعتبر تم» عند تحققه ويبقى محفوظاً، وننتظر الشرط التالي:
//   1) SMI (الرئيس)     : شراء = إغلاق تشبّع بيعي تحت -40 | بيع = إغلاق تشبّع شرائي فوق +40
//   2) MACD (الرئيس)    : شراء = الهستوجرام أحمر وخط الماكد أعلى منه ولا يكون تحته مطلقاً
//                          بيع = الهستوجرام أخضر وخط الماكد أدنى منه ولا يكون فوقه مطلقاً
//   3) Donchian (الرئيس): شراء = أخضر | بيع = أحمر
//   4) EMA50 (الرئيس)   : شراء = شمعة تغلق أدنى من EMA50 | بيع = شمعة تجتاز (تغلق فوق) EMA50
//                          حتى لو تغيّرت بعدها لا يهم — الشرط يبقى متحققاً
//   5) MACD (التأكيد)   : شراء = هستوجرام التأكيد أخضر (الخط فوق متوسطه) | بيع = أحمر
//   6) Donchian (الدخول): شراء = أحمر | بيع = أخضر
//   7) SMI (الدخول)     : أول شمعة إغلاق تشبّع: شراء ≤ -40 | بيع ≥ +40
//   8) RSI (الدخول)     : شراء = يصل 35 وتحت ثم أول تقاطع إيجابي مع متوسطه SMA-14
//                          بيع = يصل 65 وفوق ثم أول تقاطع سلبي مع متوسطه SMA-14
//   9) Stochastic 15/3/3 (الدخول): شراء = يجتاز 20 ويصير فوقه | بيع = ينزل من 80 ويصير تحته
//                          وبينه وبين تقاطع RSI ثلاث شموع أو أقل → تتم الصفقة ويصدر إعلان
//
// ملاحظات تنفيذ: كل القيم تُقرأ من الشموع المغلقة فقط (لا إعادة رسم). الشارت يجب أن يكون
// على 5 دقائق أو أقل حتى تعمل كل أزواج الفريمات.
// الخروج (حدده صاحب الاستراتيجية): الربح 1.00% ووقف الخسارة 0.75%.
// سجل على الشاشة (مقتبس بطلب صاحب الاستراتيجية): الصفقات المنفذة فقط،
// مع قيمة RSI التأكيد وRSI الرئيس لحظة الدخول ونتيجة كل صفقة (رابحة/خاسرة).
strategy("استراتيجية 6 مؤشرات — MACD+SMI+Stoch+RSI+Donchian+EMA50",
     overlay                  = true,
     pyramiding               = 0,
     initial_capital          = 100000,
     currency                 = currency.USD,
     default_qty_type         = strategy.percent_of_equity,
     default_qty_value        = 5,
     commission_type          = strategy.commission.percent,
     commission_value         = 0.04,
     process_orders_on_close  = true,
     calc_on_every_tick       = false,
     max_labels_count         = 500,
     max_bars_back            = 1000)

// ============================ المدخلات ============================
grpMacd  = "MACD"
macdSrc  = input.source(close, "مصدر", group=grpMacd)
macdF    = input.int(12, "طول الخط السريع", minval=1, group=grpMacd)
macdS    = input.int(26, "بطيء", minval=1, group=grpMacd)
macdG    = input.int(9,  "Signal length", minval=1, group=grpMacd)
macdOscT = input.string("EMA", "Oscillator MA type", options=["EMA", "SMA"], group=grpMacd)
macdSigT = input.string("EMA", "Signal MA type", options=["EMA", "SMA"], group=grpMacd)

grpSmi = "Stochastic SMI (Stoch_MTM)"
smiK   = input.int(10, "Percent K Length", minval=1, group=grpSmi)
smiD   = input.int(3,  "Percent D Length", minval=1, group=grpSmi)
smiSm  = input.int(1,  "Smoothing Period", minval=1, group=grpSmi)
obLvl  = input.float(40,  "تشبع شرائي", group=grpSmi)
osLvl  = input.float(-40, "تشبع بيعي", group=grpSmi)

grpSt  = "Stochastic"
stKlen = input.int(15, "طول %K", minval=1, group=grpSt)
stKsm  = input.int(3,  "تنعيم %K", minval=1, group=grpSt)
stDsm  = input.int(3,  "تنعيم %D", minval=1, group=grpSt)

grpRsi   = "RSI"
rsiLen   = input.int(14, "طول مؤشر القوى النسبية", minval=2, group=grpRsi)
rsiSrc   = input.source(close, "مصدر", group=grpRsi)
rsiMaLen = input.int(14, "طول تنعيم SMA", minval=1, group=grpRsi)

grpDon = "Donchian Trend Ribbon"
dlen   = input.int(20, "Donchian Channel Period", minval=10, group=grpDon)

grpEma = "EMA"
emaLen = input.int(50, "طول EMA", minval=1, group=grpEma)

grpLvl    = "مستويات الشروط"
rsiTouchL = input.float(35, "لمس RSI شراء (وتحت)", group=grpLvl)
rsiTouchS = input.float(65, "لمس RSI بيع (وفوق)", group=grpLvl)
stochBuy  = input.float(20, "ستوكاستك شراء: يجتاز ويصير فوق", group=grpLvl)
stochSell = input.float(80, "ستوكاستك بيع: ينزل ويصير تحت", group=grpLvl)
stochGap  = input.int(3, "أقصى شموع بين تقاطع RSI والستوكاستك", minval=0, group=grpLvl)

grpP  = "أزواج الفريمات (رئيس/تأكيد/دخول)"
use1  = input.bool(true, "15 / 45 / 5", group=grpP)
use2  = input.bool(true, "30 / 90 / 10", group=grpP)
use3  = input.bool(true, "45 / 135 / 15", group=grpP)
use4  = input.bool(true, "60 / 180 / 20", group=grpP)
use5  = input.bool(true, "90 / 270 / 30", group=grpP)
use6  = input.bool(true, "120 / 360 / 40", group=grpP)
use7  = input.bool(true, "150 / 450 / 50", group=grpP)
use8  = input.bool(true, "180 / 540 / 60", group=grpP)
use9  = input.bool(true, "210 / 630 / 70", group=grpP)
use10 = input.bool(true, "240 / 720 / 80", group=grpP)

grpRisk = "إدارة الصفقة"
useLong = input.bool(true, "شراء", group=grpRisk)
useShrt = input.bool(true, "بيع", group=grpRisk)
usePct  = input.bool(true, "وقف/هدف %", group=grpRisk)
tpPct   = input.float(1.00, "الربح %", step=0.01, minval=0.05, group=grpRisk)
slPct   = input.float(0.75, "وقف الخسارة %", step=0.01, minval=0.05, group=grpRisk)

grpVis  = "العرض"
showTbl = input.bool(true, "لوحة تقدم الخطوات", group=grpVis)
showLbl = input.bool(true, "ملصقات الدخول", group=grpVis)
showLog = input.bool(true, "سجل الصفقات", group=grpVis)
maxLogRows  = input.int(200, "أقصى عدد عمليات محفوظة بالسجل", minval=1, group=grpVis)
rowsPerPage = input.int(25, "عدد الصفوف المعروضة (آخر N صفقة)", minval=1, maxval=100, group=grpVis)

// ============================ دوال المؤشرات ============================
f_ma(float src, simple int len, simple string typ) =>
    s = ta.sma(src, len)
    e = ta.ema(src, len)
    typ == "SMA" ? s : e

f_macd() =>
    m = f_ma(macdSrc, macdF, macdOscT) - f_ma(macdSrc, macdS, macdOscT)
    sig = f_ma(m, macdG, macdSigT)
    [m, m - sig]

f_smi() =>
    ll = ta.lowest(low, smiK)
    hh = ta.highest(high, smiK)
    diff = hh - ll
    rdiff = close - (hh + ll) / 2.0
    avgrel = ta.ema(ta.ema(rdiff, smiD), smiD)
    avgdiff = ta.ema(ta.ema(diff, smiD), smiD)
    raw = avgdiff != 0 ? (avgrel / (avgdiff / 2.0)) * 100.0 : 0.0
    ta.sma(raw, smiSm)

// Donchian Trend Ribbon — dchannel من كود LonesomeTheBlue (اللون الرئيسي)
f_dchannel() =>
    dHH = ta.highest(high, dlen)
    dLL = ta.lowest(low, dlen)
    var int trend = 0
    trend := close > dHH[1] ? 1 : close < dLL[1] ? -1 : trend
    trend

// ============================ لقطات الفريمات ============================
// كل القيم من آخر شمعة "مغلقة" على الفريم المطلوب ([1]) — بلا إعادة رسم.

// الفريم الرئيس: شروط 1 و2 و3 و4 (+ مصدر الإلغاء للفريم الأصغر)
f_snap_main() =>
    smi = f_smi()
    [m, h] = f_macd()
    don = f_dchannel()
    ema50 = ta.ema(close, emaLen)
    rsiV = ta.rsi(rsiSrc, rsiLen)
    satL  = smi[1] <= osLvl
    satS  = smi[1] >= obLvl
    macdL = h[1] < 0 and m[1] >= h[1]
    macdS = h[1] > 0 and m[1] <= h[1]
    donL  = don[1] == 1
    donS  = don[1] == -1
    emaL  = close[1] < ema50[1]
    emaS  = close[1] > ema50[1]
    [satL, satS, macdL, macdS, donL, donS, emaL, emaS, rsiV[1]]

// فريم التأكيد: شرط 5 — لون هستوجرام MACD (+ قيمة RSI للسجل)
f_snap_conf() =>
    [m, h] = f_macd()
    rsiV = ta.rsi(rsiSrc, rsiLen)
    [h[1] > 0, h[1] < 0, rsiV[1]]

// فريم الدخول: شروط 6 و7 و8 و9
f_snap_entry() =>
    smi = f_smi()
    don = f_dchannel()
    rsi = ta.rsi(rsiSrc, rsiLen)
    rsiMa = ta.sma(rsi, rsiMaLen)
    k = ta.sma(ta.stoch(close, high, low, stKlen), stKsm)
    donRed  = don[1] == -1
    donGrn  = don[1] == 1
    satL    = smi[1] <= osLvl
    satS    = smi[1] >= obLvl
    touchL  = rsi[1] <= rsiTouchL
    touchS  = rsi[1] >= rsiTouchS
    crossUp = rsi[1] > rsiMa[1] and rsi[2] <= rsiMa[2]
    crossDn = rsi[1] < rsiMa[1] and rsi[2] >= rsiMa[2]
    stochUp = k[1] > stochBuy
    stochDn = k[1] < stochSell
    [donRed, donGrn, satL, satS, touchL, touchS, crossUp, crossDn, stochUp, stochDn]

// فريم الإلغاء الأعلى (5س = 300): تشبع SMI فقط
f_snap_sat() =>
    smi = f_smi()
    [smi[1] <= osLvl, smi[1] >= obLvl]

f_req_main(simple string tf) =>
    request.security(syminfo.tickerid, tf, f_snap_main(), barmerge.gaps_off, barmerge.lookahead_off)

f_req_conf(simple string tf) =>
    request.security(syminfo.tickerid, tf, f_snap_conf(), barmerge.gaps_off, barmerge.lookahead_off)

f_req_entry(simple string tf) =>
    request.security(syminfo.tickerid, tf, f_snap_entry(), barmerge.gaps_off, barmerge.lookahead_off)

f_req_sat(simple string tf) =>
    request.security(syminfo.tickerid, tf, f_snap_sat(), barmerge.gaps_off, barmerge.lookahead_off)

// إغلاق شمعة جديدة على الفريم (لحظة اكتمال شمعة الفريم الأعلى)
f_new(simple string tf) =>
    nz(ta.change(time(tf)), 0) != 0

// ============================ محرك التسلسل ============================
// st = عدد الشروط المكتملة (0..9). كل شرط يبقى «تم» حتى الإلغاء أو الدخول.
f_engine(bool enabled, bool cancelEvt, bool mainNew, bool s1sat, bool s2macd, bool s3don, bool s4ema, bool s5hist, bool s6don, bool entryNew, bool s7sat, bool s8touch, bool s8cross, bool s9stoch) =>
    var int st = 0
    var int gap = 0
    bool justCrossed = false
    bool fire = false
    if not enabled or cancelEvt
        st := 0
    if st == 0 and mainNew and s1sat
        st := 1
    if st == 1 and mainNew and s2macd
        st := 2
    if st == 2 and s3don
        st := 3
    if st == 3 and s4ema
        st := 4
    if st == 4 and s5hist
        st := 5
    if st == 5 and s6don
        st := 6
    if st == 6 and entryNew and s7sat
        st := 7
    if st == 7 and entryNew and s8touch
        st := 8
    if (st == 8 or st == 9) and entryNew and s8cross
        st := 9
        gap := 0
        justCrossed := true
    if st == 9 and entryNew
        if not justCrossed
            gap += 1
        if gap > stochGap
            st := 8
        else if s9stoch
            fire := true
            st := 0
    [fire, st]

// ============================ جلب البيانات ============================
[m1satL, m1satS, m1macdL, m1macdS, m1donL, m1donS, m1emaL, m1emaS, m1rsi] = f_req_main("15")
[m2satL, m2satS, m2macdL, m2macdS, m2donL, m2donS, m2emaL, m2emaS, m2rsi] = f_req_main("30")
[m3satL, m3satS, m3macdL, m3macdS, m3donL, m3donS, m3emaL, m3emaS, m3rsi] = f_req_main("45")
[m4satL, m4satS, m4macdL, m4macdS, m4donL, m4donS, m4emaL, m4emaS, m4rsi] = f_req_main("60")
[m5satL, m5satS, m5macdL, m5macdS, m5donL, m5donS, m5emaL, m5emaS, m5rsi] = f_req_main("90")
[m6satL, m6satS, m6macdL, m6macdS, m6donL, m6donS, m6emaL, m6emaS, m6rsi] = f_req_main("120")
[m7satL, m7satS, m7macdL, m7macdS, m7donL, m7donS, m7emaL, m7emaS, m7rsi] = f_req_main("150")
[m8satL, m8satS, m8macdL, m8macdS, m8donL, m8donS, m8emaL, m8emaS, m8rsi] = f_req_main("180")
[m9satL, m9satS, m9macdL, m9macdS, m9donL, m9donS, m9emaL, m9emaS, m9rsi] = f_req_main("210")
[m10satL, m10satS, m10macdL, m10macdS, m10donL, m10donS, m10emaL, m10emaS, m10rsi] = f_req_main("240")

[c1G, c1R, c1rsi] = f_req_conf("45")
[c2G, c2R, c2rsi] = f_req_conf("90")
[c3G, c3R, c3rsi] = f_req_conf("135")
[c4G, c4R, c4rsi] = f_req_conf("180")
[c5G, c5R, c5rsi] = f_req_conf("270")
[c6G, c6R, c6rsi] = f_req_conf("360")
[c7G, c7R, c7rsi] = f_req_conf("450")
[c8G, c8R, c8rsi] = f_req_conf("540")
[c9G, c9R, c9rsi] = f_req_conf("630")
[c10G, c10R, c10rsi] = f_req_conf("720")

[e1dR, e1dG, e1sL, e1sS, e1tL, e1tS, e1cU, e1cD, e1stB, e1stS] = f_req_entry("5")
[e2dR, e2dG, e2sL, e2sS, e2tL, e2tS, e2cU, e2cD, e2stB, e2stS] = f_req_entry("10")
[e3dR, e3dG, e3sL, e3sS, e3tL, e3tS, e3cU, e3cD, e3stB, e3stS] = f_req_entry("15")
[e4dR, e4dG, e4sL, e4sS, e4tL, e4tS, e4cU, e4cD, e4stB, e4stS] = f_req_entry("20")
[e5dR, e5dG, e5sL, e5sS, e5tL, e5tS, e5cU, e5cD, e5stB, e5stS] = f_req_entry("30")
[e6dR, e6dG, e6sL, e6sS, e6tL, e6tS, e6cU, e6cD, e6stB, e6stS] = f_req_entry("40")
[e7dR, e7dG, e7sL, e7sS, e7tL, e7tS, e7cU, e7cD, e7stB, e7stS] = f_req_entry("50")
[e8dR, e8dG, e8sL, e8sS, e8tL, e8tS, e8cU, e8cD, e8stB, e8stS] = f_req_entry("60")
[e9dR, e9dG, e9sL, e9sS, e9tL, e9tS, e9cU, e9cD, e9stB, e9stS] = f_req_entry("70")
[e10dR, e10dG, e10sL, e10sS, e10tL, e10tS, e10cU, e10cD, e10stB, e10stS] = f_req_entry("80")

[sat300L, sat300S] = f_req_sat("300")

n15  = f_new("15")
n30  = f_new("30")
n45  = f_new("45")
n60  = f_new("60")
n90  = f_new("90")
n120 = f_new("120")
n150 = f_new("150")
n180 = f_new("180")
n210 = f_new("210")
n240 = f_new("240")
n300 = f_new("300")
n5   = f_new("5")
n10  = f_new("10")
n20  = f_new("20")
n40  = f_new("40")
n50  = f_new("50")
n70  = f_new("70")
n80  = f_new("80")

// ============================ تشغيل المحركات ============================
// الإلغاء: إغلاق تشبّع بنفس الاتجاه على الفريم الرئيس الأكبر يلغي الأصغر.
[f1L, st1L]  = f_engine(use1,  n30 and m2satL,   n15,  m1satL,  m1macdL,  m1donL,  m1emaL,  c1G,  e1dR,  n5,  e1sL,  e1tL,  e1cU,  e1stB)
[f1S, st1S]  = f_engine(use1,  n30 and m2satS,   n15,  m1satS,  m1macdS,  m1donS,  m1emaS,  c1R,  e1dG,  n5,  e1sS,  e1tS,  e1cD,  e1stS)
[f2L, st2L]  = f_engine(use2,  n45 and m3satL,   n30,  m2satL,  m2macdL,  m2donL,  m2emaL,  c2G,  e2dR,  n10, e2sL,  e2tL,  e2cU,  e2stB)
[f2S, st2S]  = f_engine(use2,  n45 and m3satS,   n30,  m2satS,  m2macdS,  m2donS,  m2emaS,  c2R,  e2dG,  n10, e2sS,  e2tS,  e2cD,  e2stS)
[f3L, st3L]  = f_engine(use3,  n60 and m4satL,   n45,  m3satL,  m3macdL,  m3donL,  m3emaL,  c3G,  e3dR,  n15, e3sL,  e3tL,  e3cU,  e3stB)
[f3S, st3S]  = f_engine(use3,  n60 and m4satS,   n45,  m3satS,  m3macdS,  m3donS,  m3emaS,  c3R,  e3dG,  n15, e3sS,  e3tS,  e3cD,  e3stS)
[f4L, st4L]  = f_engine(use4,  n90 and m5satL,   n60,  m4satL,  m4macdL,  m4donL,  m4emaL,  c4G,  e4dR,  n20, e4sL,  e4tL,  e4cU,  e4stB)
[f4S, st4S]  = f_engine(use4,  n90 and m5satS,   n60,  m4satS,  m4macdS,  m4donS,  m4emaS,  c4R,  e4dG,  n20, e4sS,  e4tS,  e4cD,  e4stS)
[f5L, st5L]  = f_engine(use5,  n120 and m6satL,  n90,  m5satL,  m5macdL,  m5donL,  m5emaL,  c5G,  e5dR,  n30, e5sL,  e5tL,  e5cU,  e5stB)
[f5S, st5S]  = f_engine(use5,  n120 and m6satS,  n90,  m5satS,  m5macdS,  m5donS,  m5emaS,  c5R,  e5dG,  n30, e5sS,  e5tS,  e5cD,  e5stS)
[f6L, st6L]  = f_engine(use6,  n150 and m7satL,  n120, m6satL,  m6macdL,  m6donL,  m6emaL,  c6G,  e6dR,  n40, e6sL,  e6tL,  e6cU,  e6stB)
[f6S, st6S]  = f_engine(use6,  n150 and m7satS,  n120, m6satS,  m6macdS,  m6donS,  m6emaS,  c6R,  e6dG,  n40, e6sS,  e6tS,  e6cD,  e6stS)
[f7L, st7L]  = f_engine(use7,  n180 and m8satL,  n150, m7satL,  m7macdL,  m7donL,  m7emaL,  c7G,  e7dR,  n50, e7sL,  e7tL,  e7cU,  e7stB)
[f7S, st7S]  = f_engine(use7,  n180 and m8satS,  n150, m7satS,  m7macdS,  m7donS,  m7emaS,  c7R,  e7dG,  n50, e7sS,  e7tS,  e7cD,  e7stS)
[f8L, st8L]  = f_engine(use8,  n210 and m9satL,  n180, m8satL,  m8macdL,  m8donL,  m8emaL,  c8G,  e8dR,  n60, e8sL,  e8tL,  e8cU,  e8stB)
[f8S, st8S]  = f_engine(use8,  n210 and m9satS,  n180, m8satS,  m8macdS,  m8donS,  m8emaS,  c8R,  e8dG,  n60, e8sS,  e8tS,  e8cD,  e8stS)
[f9L, st9L]  = f_engine(use9,  n240 and m10satL, n210, m9satL,  m9macdL,  m9donL,  m9emaL,  c9G,  e9dR,  n70, e9sL,  e9tL,  e9cU,  e9stB)
[f9S, st9S]  = f_engine(use9,  n240 and m10satS, n210, m9satS,  m9macdS,  m9donS,  m9emaS,  c9R,  e9dG,  n70, e9sS,  e9tS,  e9cD,  e9stS)
[f10L, st10L] = f_engine(use10, n300 and sat300L, n240, m10satL, m10macdL, m10donL, m10emaL, c10G, e10dR, n80, e10sL, e10tL, e10cU, e10stB)
[f10S, st10S] = f_engine(use10, n300 and sat300S, n240, m10satS, m10macdS, m10donS, m10emaS, c10R, e10dG, n80, e10sS, e10tS, e10cD, e10stS)

// ============================ الدخول والإعلان ============================
buyHit  = useLong and (f1L or f2L or f3L or f4L or f5L or f6L or f7L or f8L or f9L or f10L)
sellHit = useShrt and (f1S or f2S or f3S or f4S or f5S or f6S or f7S or f8S or f9S or f10S)
buyTag  = f1L ? "15/45/5" : f2L ? "30/90/10" : f3L ? "45/135/15" : f4L ? "60/180/20" : f5L ? "90/270/30" : f6L ? "120/360/40" : f7L ? "150/450/50" : f8L ? "180/540/60" : f9L ? "210/630/70" : "240/720/80"
sellTag = f1S ? "15/45/5" : f2S ? "30/90/10" : f3S ? "45/135/15" : f4S ? "60/180/20" : f5S ? "90/270/30" : f6S ? "120/360/40" : f7S ? "150/450/50" : f8S ? "180/540/60" : f9S ? "210/630/70" : "240/720/80"

// قيم RSI الرئيس والتأكيد للزوج الذي أطلق الصفقة (للسجل)
buyRsiMain  = f1L ? m1rsi : f2L ? m2rsi : f3L ? m3rsi : f4L ? m4rsi : f5L ? m5rsi : f6L ? m6rsi : f7L ? m7rsi : f8L ? m8rsi : f9L ? m9rsi : m10rsi
buyRsiConf  = f1L ? c1rsi : f2L ? c2rsi : f3L ? c3rsi : f4L ? c4rsi : f5L ? c5rsi : f6L ? c6rsi : f7L ? c7rsi : f8L ? c8rsi : f9L ? c9rsi : c10rsi
sellRsiMain = f1S ? m1rsi : f2S ? m2rsi : f3S ? m3rsi : f4S ? m4rsi : f5S ? m5rsi : f6S ? m6rsi : f7S ? m7rsi : f8S ? m8rsi : f9S ? m9rsi : m10rsi
sellRsiConf = f1S ? c1rsi : f2S ? c2rsi : f3S ? c3rsi : f4S ? c4rsi : f5S ? c5rsi : f6S ? c6rsi : f7S ? c7rsi : f8S ? c8rsi : f9S ? c9rsi : c10rsi

// الصفقة تُنفذ فقط إذا لم تكن هناك صفقة قائمة بنفس الاتجاه — والسجل يعرض المنفذة فقط
enterLong  = buyHit and strategy.position_size <= 0
enterShort = sellHit and strategy.position_size >= 0

var float longStop  = na
var float longLim   = na
var float shortStop = na
var float shortLim  = na

if enterLong
    strategy.entry("Long", strategy.long, comment="شراء " + buyTag)
    longStop := close * (1.0 - slPct / 100.0)
    longLim  := close * (1.0 + tpPct / 100.0)
    alert("استراتيجية 6 مؤشرات: صفقة شراء " + buyTag + " — " + syminfo.ticker + " @ " + str.tostring(close), alert.freq_once_per_bar)

if enterShort
    strategy.entry("Short", strategy.short, comment="بيع " + sellTag)
    shortStop := close * (1.0 + slPct / 100.0)
    shortLim  := close * (1.0 - tpPct / 100.0)
    alert("استراتيجية 6 مؤشرات: صفقة بيع " + sellTag + " — " + syminfo.ticker + " @ " + str.tostring(close), alert.freq_once_per_bar)

// ================= سجل الصفقات (مقتبس من الكود الذي أرسله صاحب الاستراتيجية) =================
var array<string> logTime       = array.new<string>()
var array<string> logType       = array.new<string>()
var array<string> logTag        = array.new<string>()
var array<float>  logRsiConfirm = array.new<float>()
var array<float>  logRsiMain    = array.new<float>()
var array<string> logResult     = array.new<string>()
var array<int>    logId         = array.new<int>()
var int nextTradeId = 0
var array<int> pendingQueue = array.new<int>()

if enterLong or enterShort
    array.unshift(logTime, str.format_time(time, "yyyy-MM-dd HH:mm"))
    array.unshift(logType, enterLong ? "شراء" : "بيع")
    array.unshift(logTag, enterLong ? buyTag : sellTag)
    array.unshift(logRsiConfirm, enterLong ? buyRsiConf : sellRsiConf)
    array.unshift(logRsiMain, enterLong ? buyRsiMain : sellRsiMain)
    array.unshift(logResult, "قيد التنفيذ")
    array.unshift(logId, nextTradeId)
    array.push(pendingQueue, nextTradeId)
    nextTradeId += 1
    if array.size(logTime) > maxLogRows
        array.pop(logTime)
        array.pop(logType)
        array.pop(logTag)
        array.pop(logRsiConfirm)
        array.pop(logRsiMain)
        array.pop(logResult)
        array.pop(logId)

var int lastClosedCount = 0
if strategy.closedtrades > lastClosedCount
    for ci = lastClosedCount to strategy.closedtrades - 1
        if array.size(pendingQueue) > 0
            closedId = array.shift(pendingQueue)
            rowIdx = array.indexof(logId, closedId)
            if rowIdx >= 0
                array.set(logResult, rowIdx, strategy.closedtrades.profit(ci) >= 0 ? "رابحة" : "خاسرة")
    lastClosedCount := strategy.closedtrades

if usePct and strategy.position_size > 0
    strategy.exit("L-Exit", from_entry="Long", stop=longStop, limit=longLim)
if usePct and strategy.position_size < 0
    strategy.exit("S-Exit", from_entry="Short", stop=shortStop, limit=shortLim)

alertcondition(enterLong,  title="شراء (أي زوج)", message="استراتيجية 6 مؤشرات: صفقة شراء")
alertcondition(enterShort, title="بيع (أي زوج)",  message="استراتيجية 6 مؤشرات: صفقة بيع")

// ============================ العرض ============================
plotshape(enterLong,  title="شراء", style=shape.triangleup,   location=location.belowbar, color=color.lime, size=size.small)
plotshape(enterShort, title="بيع",  style=shape.triangledown, location=location.abovebar, color=color.red,  size=size.small)

if showLbl and enterLong
    label.new(bar_index, low, "شراء\n" + buyTag, style=label.style_label_up, color=color.lime, textcolor=color.black, size=size.small)
if showLbl and enterShort
    label.new(bar_index, high, "بيع\n" + sellTag, style=label.style_label_down, color=color.red, textcolor=color.white, size=size.small)

// تحذير: الشارت يجب أن يكون أصغر من/يساوي أصغر فريم دخول مفعّل
minEntrySec = use1 ? 300 : use2 ? 600 : use3 ? 900 : use4 ? 1200 : use5 ? 1800 : use6 ? 2400 : use7 ? 3000 : use8 ? 3600 : use9 ? 4200 : use10 ? 4800 : 4800
var label warnLbl = label.new(bar_index, high, "", style=label.style_label_left, color=color.new(color.orange, 0), textcolor=color.black, size=size.normal)
if timeframe.in_seconds() > minEntrySec
    label.set_xy(warnLbl, bar_index, high)
    label.set_text(warnLbl, "حط الشارت على " + str.tostring(minEntrySec / 60) + " دقيقة أو أقل\nحتى تعمل كل أزواج الفريمات المفعّلة")
else
    label.set_text(warnLbl, "")

// لوحة تقدم الخطوات (الأرقام = الشروط المكتملة من 0 إلى 9)
f_stCol(int st) => st == 0 ? color.new(color.gray, 80) : st < 5 ? color.new(color.teal, 60) : st < 9 ? color.new(color.olive, 40) : color.new(color.green, 20)
var table panel = table.new(position.top_right, 3, 11, bgcolor=color.new(#111111, 15), border_width=1, border_color=color.new(color.gray, 60))
if showTbl and barstate.islast
    table.cell(panel, 0, 0, "زوج", text_color=color.white, text_size=size.small)
    table.cell(panel, 1, 0, "شراء", text_color=color.white, text_size=size.small)
    table.cell(panel, 2, 0, "بيع", text_color=color.white, text_size=size.small)
    table.cell(panel, 0, 1, "15/45/5", text_color=color.white, text_size=size.small)
    table.cell(panel, 1, 1, str.tostring(st1L), bgcolor=f_stCol(st1L), text_color=color.white, text_size=size.small)
    table.cell(panel, 2, 1, str.tostring(st1S), bgcolor=f_stCol(st1S), text_color=color.white, text_size=size.small)
    table.cell(panel, 0, 2, "30/90/10", text_color=color.white, text_size=size.small)
    table.cell(panel, 1, 2, str.tostring(st2L), bgcolor=f_stCol(st2L), text_color=color.white, text_size=size.small)
    table.cell(panel, 2, 2, str.tostring(st2S), bgcolor=f_stCol(st2S), text_color=color.white, text_size=size.small)
    table.cell(panel, 0, 3, "45/135/15", text_color=color.white, text_size=size.small)
    table.cell(panel, 1, 3, str.tostring(st3L), bgcolor=f_stCol(st3L), text_color=color.white, text_size=size.small)
    table.cell(panel, 2, 3, str.tostring(st3S), bgcolor=f_stCol(st3S), text_color=color.white, text_size=size.small)
    table.cell(panel, 0, 4, "60/180/20", text_color=color.white, text_size=size.small)
    table.cell(panel, 1, 4, str.tostring(st4L), bgcolor=f_stCol(st4L), text_color=color.white, text_size=size.small)
    table.cell(panel, 2, 4, str.tostring(st4S), bgcolor=f_stCol(st4S), text_color=color.white, text_size=size.small)
    table.cell(panel, 0, 5, "90/270/30", text_color=color.white, text_size=size.small)
    table.cell(panel, 1, 5, str.tostring(st5L), bgcolor=f_stCol(st5L), text_color=color.white, text_size=size.small)
    table.cell(panel, 2, 5, str.tostring(st5S), bgcolor=f_stCol(st5S), text_color=color.white, text_size=size.small)
    table.cell(panel, 0, 6, "120/360/40", text_color=color.white, text_size=size.small)
    table.cell(panel, 1, 6, str.tostring(st6L), bgcolor=f_stCol(st6L), text_color=color.white, text_size=size.small)
    table.cell(panel, 2, 6, str.tostring(st6S), bgcolor=f_stCol(st6S), text_color=color.white, text_size=size.small)
    table.cell(panel, 0, 7, "150/450/50", text_color=color.white, text_size=size.small)
    table.cell(panel, 1, 7, str.tostring(st7L), bgcolor=f_stCol(st7L), text_color=color.white, text_size=size.small)
    table.cell(panel, 2, 7, str.tostring(st7S), bgcolor=f_stCol(st7S), text_color=color.white, text_size=size.small)
    table.cell(panel, 0, 8, "180/540/60", text_color=color.white, text_size=size.small)
    table.cell(panel, 1, 8, str.tostring(st8L), bgcolor=f_stCol(st8L), text_color=color.white, text_size=size.small)
    table.cell(panel, 2, 8, str.tostring(st8S), bgcolor=f_stCol(st8S), text_color=color.white, text_size=size.small)
    table.cell(panel, 0, 9, "210/630/70", text_color=color.white, text_size=size.small)
    table.cell(panel, 1, 9, str.tostring(st9L), bgcolor=f_stCol(st9L), text_color=color.white, text_size=size.small)
    table.cell(panel, 2, 9, str.tostring(st9S), bgcolor=f_stCol(st9S), text_color=color.white, text_size=size.small)
    table.cell(panel, 0, 10, "240/720/80", text_color=color.white, text_size=size.small)
    table.cell(panel, 1, 10, str.tostring(st10L), bgcolor=f_stCol(st10L), text_color=color.white, text_size=size.small)
    table.cell(panel, 2, 10, str.tostring(st10S), bgcolor=f_stCol(st10S), text_color=color.white, text_size=size.small)

// جدول سجل الصفقات على الشاشة (مقتبس من الكود الذي أرسله صاحب الاستراتيجية)
var table logTbl = table.new(position.top_left, 6, 102, border_width=1)
if showLog and barstate.islast
    totalRecords = array.size(logTime)
    displayCount = math.min(rowsPerPage, totalRecords)
    table.cell(logTbl, 0, 0, "آخر " + str.tostring(displayCount) + " صفقة من أصل " + str.tostring(totalRecords), bgcolor=color.black, text_color=color.white, text_size=size.small)
    table.merge_cells(logTbl, 0, 0, 5, 0)
    table.cell(logTbl, 0, 1, "وقت الدخول", bgcolor=color.navy, text_color=color.white, text_size=size.small)
    table.cell(logTbl, 1, 1, "الاتجاه", bgcolor=color.navy, text_color=color.white, text_size=size.small)
    table.cell(logTbl, 2, 1, "الزوج", bgcolor=color.navy, text_color=color.white, text_size=size.small)
    table.cell(logTbl, 3, 1, "RSI تأكيد", bgcolor=color.navy, text_color=color.white, text_size=size.small)
    table.cell(logTbl, 4, 1, "RSI رئيس", bgcolor=color.navy, text_color=color.white, text_size=size.small)
    table.cell(logTbl, 5, 1, "النتيجة", bgcolor=color.navy, text_color=color.white, text_size=size.small)
    if totalRecords > 0
        for i = 0 to displayCount - 1
            rowColor = array.get(logType, i) == "شراء" ? color.new(color.green, 80) : color.new(color.red, 80)
            rowInTable = i + 2
            result = array.get(logResult, i)
            resultColor = result == "رابحة" ? color.new(color.green, 60) : result == "خاسرة" ? color.new(color.red, 60) : color.new(color.gray, 60)
            table.cell(logTbl, 0, rowInTable, array.get(logTime, i), bgcolor=rowColor, text_size=size.small)
            table.cell(logTbl, 1, rowInTable, array.get(logType, i), bgcolor=rowColor, text_size=size.small)
            table.cell(logTbl, 2, rowInTable, array.get(logTag, i), bgcolor=rowColor, text_size=size.small)
            table.cell(logTbl, 3, rowInTable, str.tostring(array.get(logRsiConfirm, i), "#.##"), bgcolor=rowColor, text_size=size.small)
            table.cell(logTbl, 4, rowInTable, str.tostring(array.get(logRsiMain, i), "#.##"), bgcolor=rowColor, text_size=size.small)
            table.cell(logTbl, 5, rowInTable, result, bgcolor=resultColor, text_color=color.white, text_size=size.small)
