//@version=5
// استراتيجية تسلسل 9 شروط × 10 أزواج. الشارت 1د. lookahead_off = آخر شمعة مغلقة.
//
// رئيس: 1 SMI ±40 → 2 MACD (شراء أحمر وخط فوق الهستوجرام | بيع أخضر وخط تحت الهستوجرام)
//      → 3 Donchian (شراء أخضر | بيع أحمر) → 4 شمعة تحت/فوق EMA50 (يثبت ولو انعكس بعدها)
// تأكيد ×3: 5 MACD (شراء هستوجرام أخضر | بيع أحمر)
// دخول ÷3: 6 Donchian معاكس (شراء أحمر | بيع أخضر)
//          → 7 أول إغلاق SMI ±40
//          → 8 RSI يلمس 35/65 ثم أول تقاطع مع SMA14
//          → 9 Stoch %K فوق 80 خلال 3 شموع من تقاطع RSI (شراء وبيع)
//
// الإلغاء: إغلاق فريم رئيس أكبر يلغي كل الأصغر. 5س يلغي 4س.
strategy("S6 — تسلسل 9",
     overlay                 = true,
     pyramiding              = 0,
     initial_capital         = 100000,
     currency                = currency.USD,
     default_qty_type        = strategy.percent_of_equity,
     default_qty_value       = 2,
     commission_type         = strategy.commission.percent,
     commission_value        = 0.04,
     process_orders_on_close = true,
     calc_on_every_tick      = false,
     max_labels_count        = 500,
     max_bars_back           = 1000)

grpM = "MACD"
macdF = input.int(12, "طول الخط السريع", minval=1, group=grpM)
macdS = input.int(26, "بطيء", minval=1, group=grpM)
macdG = input.int(9,  "طول الإشارة", minval=1, group=grpM)

grpSmi = "SMI / Stoch_MTM"
smiK   = input.int(10, "Percent K Length", minval=1, group=grpSmi)
smiD   = input.int(3,  "Percent D Length", minval=1, group=grpSmi)
smiEma = input.int(10, "EMA Signal Length", minval=1, group=grpSmi)
smiSm  = input.int(1,  "Smoothing Period", minval=1, group=grpSmi)
smiOb  = input.float(40,  "تشبع شرائي", group=grpSmi)
smiOs  = input.float(-40, "تشبع بيعي", group=grpSmi)

grpSt = "Stochastic"
stKlen   = input.int(15, "%K Length", minval=1, group=grpSt)
stKsm    = input.int(3,  "%K Smoothing", minval=1, group=grpSt)
stDsm    = input.int(3,  "%D Smoothing", minval=1, group=grpSt)
stochLvl = input.float(80, "دخول فوق %K", group=grpSt)
stochGap = input.int(3, "أقصى شموع بعد تقاطع RSI", minval=0, group=grpSt)

grpR = "RSI"
rsiLen   = input.int(14, "RSI Length", minval=2, group=grpR)
rsiMaLen = input.int(14, "SMA على RSI", minval=1, group=grpR)
rsiOs    = input.float(35, "لمس RSI شراء <=", group=grpR)
rsiOb    = input.float(65, "لمس RSI بيع >=", group=grpR)

grpD = "Donchian Trend Ribbon"
dlen = input.int(20, "Donchian Channel Period", minval=10, group=grpD)

grpE = "EMA"
emaLen = input.int(50, "EMA", minval=1, group=grpE)

grpP = "الأزواج"
use15  = input.bool(true, "1) 15د / 45د / 5د", group=grpP)
use30  = input.bool(true, "2) 30د / 90د / 10د", group=grpP)
use45  = input.bool(true, "3) 45د / 135د / 15د", group=grpP)
use60  = input.bool(true, "4) 1س / 3س / 20د", group=grpP)
use90  = input.bool(true, "5) 90د / 270د / 30د", group=grpP)
use120 = input.bool(true, "6) 2س / 6س / 2س", group=grpP)
use150 = input.bool(true, "7) 150د / 450د / 50د", group=grpP)
use180 = input.bool(true, "8) 3س / 9س / 1س", group=grpP)
use210 = input.bool(true, "9) 210د / 630د / 70د", group=grpP)
use240 = input.bool(true, "10) 4س / 12س / 80د", group=grpP)

grpX = "إغلاق"
useLong = input.bool(true, "شراء", group=grpX)
useShrt = input.bool(true, "بيع", group=grpX)
usePct  = input.bool(true, "وقف/هدف %", group=grpX)
tpPct   = input.float(2.0, "هدف %", step=0.1, group=grpX)
slPct   = input.float(2.0, "وقف %", step=0.1, group=grpX)
exitOpp = input.bool(true, "إغلاق عكسي", group=grpX)

grpV = "عرض"
showTbl = input.bool(true, "لوحة التسلسل", group=grpV)
showLbl = input.bool(true, "ملصقات الدخول", group=grpV)

f_smi() =>
    ll = ta.lowest(low, smiK)
    hh = ta.highest(high, smiK)
    diff = hh - ll
    rdiff = close - (hh + ll) / 2.0
    avgrel = ta.ema(ta.ema(rdiff, smiD), smiD)
    avgdiff = ta.ema(ta.ema(diff, smiD), smiD)
    raw = avgdiff != 0 ? (avgrel / (avgdiff / 2.0)) * 100.0 : 0.0
    ta.sma(raw, smiSm)

f_don() =>
    var int trend = 0
    hh = ta.highest(high, dlen)
    ll = ta.lowest(low, dlen)
    trend := close > hh[1] ? 1 : close < ll[1] ? -1 : trend
    trend

f_snap() =>
    [macdLine, sigLine, hist] = ta.macd(close, macdF, macdS, macdG)
    smi = f_smi()
    k = ta.sma(ta.stoch(close, high, low, stKlen), stKsm)
    d = ta.sma(k, stDsm)
    rsi = ta.rsi(close, rsiLen)
    rsiMa = ta.sma(rsi, rsiMaLen)
    don = f_don()
    ema = ta.ema(close, emaLen)
    hist2 = hist + nz(sigLine) * 0.0 + nz(d) * 0.0
    [time, close, hist2, macdLine, smi, k, rsi, rsiMa, don, ema]

f_req(simple string tf) =>
    request.security(syminfo.tickerid, tf, f_snap(), barmerge.gaps_off, barmerge.lookahead_off)

f_closed(int t) =>
    not na(t) and t != t[1]

[t5,   cl5,   h5,   m5,   smi5,   k5,   rsi5,   rma5,   don5,   ema5]   = f_req("5")
