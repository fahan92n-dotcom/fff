if showLog
    string txt = "Cascade | ناجحة " + str.tostring(array.get(tally, 0)) + " | فاشلة " + str.tostring(array.get(tally, 1)) + " | مفتوحة " + str.tostring(array.size(pTime)) + "\n"
    txt += "ربح " + str.tostring(histWin, "#.##") + "%  خسارة " + str.tostring(histLoss, "#.##") + "% | الشارت: 20م أو أقل\n"
    txt += f_row("15 B", L15_1, L15_2, L15_3, L15_4, L15_5, L15_6, L15_7, L15_8) + " " + f_row("S", S15_1, S15_2, S15_3, S15_4, S15_5, S15_6, S15_7, S15_8) + "\n"
    txt += f_row("18 B", L18_1, L18_2, L18_3, L18_4, L18_5, L18_6, L18_7, L18_8) + " " + f_row("S", S18_1, S18_2, S18_3, S18_4, S18_5, S18_6, S18_7, S18_8) + "\n"
    txt += f_row("21 B", L21_1, L21_2, L21_3, L21_4, L21_5, L21_6, L21_7, L21_8) + " " + f_row("S", S21_1, S21_2, S21_3, S21_4, S21_5, S21_6, S21_7, S21_8) + "\n"
    txt += f_row("24 B", L24_1, L24_2, L24_3, L24_4, L24_5, L24_6, L24_7, L24_8) + " " + f_row("S", S24_1, S24_2, S24_3, S24_4, S24_5, S24_6, S24_7, S24_8) + "\n"
    txt += f_row("27 B", L27_1, L27_2, L27_3, L27_4, L27_5, L27_6, L27_7, L27_8) + " " + f_row("S", S27_1, S27_2, S27_3, S27_4, S27_5, S27_6, S27_7, S27_8) + "\n"
    txt += f_row("30 B", L30_1, L30_2, L30_3, L30_4, L30_5, L30_6, L30_7, L30_8) + " " + f_row("S", S30_1, S30_2, S30_3, S30_4, S30_5, S30_6, S30_7, S30_8) + "\n"
    txt += f_row("45 B", L45_1, L45_2, L45_3, L45_4, L45_5, L45_6, L45_7, L45_8) + " " + f_row("S", S45_1, S45_2, S45_3, S45_4, S45_5, S45_6, S45_7, S45_8) + "\n"
    txt += f_row("60 B", L60_1, L60_2, L60_3, L60_4, L60_5, L60_6, L60_7, L60_8) + " " + f_row("S", S60_1, S60_2, S60_3, S60_4, S60_5, S60_6, S60_7, S60_8) + "\n"
    txt += f_row("90 B", L90_1, L90_2, L90_3, L90_4, L90_5, L90_6, L90_7, L90_8) + " " + f_row("S", S90_1, S90_2, S90_3, S90_4, S90_5, S90_6, S90_7, S90_8) + "\n"
    txt += f_row("120 B", L120_1, L120_2, L120_3, L120_4, L120_5, L120_6, L120_7, L120_8) + " " + f_row("S", S120_1, S120_2, S120_3, S120_4, S120_5, S120_6, S120_7, S120_8) + "\n"
    txt += f_row("150 B", L150_1, L150_2, L150_3, L150_4, L150_5, L150_6, L150_7, L150_8) + " " + f_row("S", S150_1, S150_2, S150_3, S150_4, S150_5, S150_6, S150_7, S150_8) + "\n"
    txt += f_row("210 B", L210_1, L210_2, L210_3, L210_4, L210_5, L210_6, L210_7, L210_8) + " " + f_row("S", S210_1, S210_2, S210_3, S210_4, S210_5, S210_6, S210_7, S210_8) + "\n"
    txt += f_row("240 B", L240_1, L240_2, L240_3, L240_4, L240_5, L240_6, L240_7, L240_8) + " " + f_row("S", S240_1, S240_2, S240_3, S240_4, S240_5, S240_6, S240_7, S240_8)
    if chartTooHigh
        txt += "\nحط الشارت على 20م أو أقل حتى تظهر الأسهم"
    label.set_xy(logLbl, bar_index, high)
    label.set_text(logLbl, txt)
else
    label.set_text(logLbl, "")

f_cell(table t, int col, int row, string txt, color fg, color bg) =>
    table.cell(t, col, row, txt, text_color=fg, bgcolor=bg, text_size=size.small, text_halign=text.align_center)

var table scoreBox = table.new(position.top_left, 4, 24, bgcolor=color.new(#141414, 4), border_width=1, border_color=color.new(#555555, 0), frame_color=color.new(#777777, 25), frame_width=1)
var bool scoreMerged = false
if not scoreMerged
    table.merge_cells(scoreBox, 0, 0, 3, 0)
    table.merge_cells(scoreBox, 0, 1, 3, 1)
    table.merge_cells(scoreBox, 0, 2, 3, 2)
    scoreMerged := true

if barstate.islast
    if showScore
        int wins = array.get(tally, 0)
        int losses = array.get(tally, 1)
        color scoreFg = wins > losses ? color.lime : losses > wins ? color.red : color.silver
        color hd = color.new(#1b3a5c, 0)
        color bg = color.new(#1a1a1a, 0)
        int nHist = array.size(hTime)
        int pages = int(math.max(1, math.ceil(nHist / float(pageSize))))
        int page = math.min(scorePage, pages)
        int skip = (page - 1) * pageSize
        int nBars = bar_index + 1
        float loadedDays = (time - firstBarTime) / 86400000.0
        string loadTxt = loadedDays >= 1.0 ? ("تم تحميل " + str.tostring(loadedDays, "#.#") + " يوم") : ("تم تحميل " + str.tostring(loadedDays * 24.0, "#.#") + " ساعة")
        loadTxt += "  (" + str.tostring(nBars) + " شمعة)"
        f_cell(scoreBox, 0, 0, "نتائج الصفقات   صفحة " + str.tostring(page) + " / " + str.tostring(pages) + "   |   " + loadTxt, color.white, hd)
        f_cell(scoreBox, 0, 1, "ربح " + str.tostring(histWin, "#.##") + "%   |   خسارة " + str.tostring(histLoss, "#.##") + "%   |   غيّر الصفحة من الإعدادات", color.silver, bg)
        f_cell(scoreBox, 0, 2, "ناجحة " + str.tostring(wins) + "  |  فاشلة " + str.tostring(losses) + "  |  مفتوحة " + str.tostring(array.size(pTime)), scoreFg, bg)
        f_cell(scoreBox, 0, 3, "الصفقة", color.white, hd)
        f_cell(scoreBox, 1, 3, "النتيجة", color.white, hd)
        f_cell(scoreBox, 2, 3, "RSI رئيس", color.white, hd)
        f_cell(scoreBox, 3, 3, "RSI تأكيد", color.white, hd)
        for k = 0 to pageSize - 1
            int src = nHist - 1 - skip - k
            int row = 4 + k
            if src >= 0
                int side = array.get(hSide, src)
                int win = array.get(hWin, src)
                string sideAr = side == 1 ? "شراء " : "بيع "
                string resTxt = win == 1 ? "ناجحة" : "فاشلة"
                color resFg = win == 1 ? color.lime : color.red
                f_cell(scoreBox, 0, row, sideAr + array.get(hTag, src), color.white, bg)
                f_cell(scoreBox, 1, row, resTxt, resFg, bg)
                f_cell(scoreBox, 2, row, f_rsi_txt(array.get(hRsiM, src)), color.silver, bg)
                f_cell(scoreBox, 3, row, f_rsi_txt(array.get(hRsiC, src)), color.silver, bg)
            else
                f_cell(scoreBox, 0, row, "", color.white, bg)
                f_cell(scoreBox, 1, row, "", color.white, bg)
                f_cell(scoreBox, 2, row, "", color.white, bg)
                f_cell(scoreBox, 3, row, "", color.white, bg)
    else
        table.clear(scoreBox, 0, 0, 3, 23)

alertcondition(buyHit, title="شراء", message="Cascade شراء")
alertcondition(sellHit, title="بيع", message="Cascade بيع")
