[S240_1, S240_2, S240_3, S240_4, S240_5, S240_6, S240_7, S240_8, S240_9, hit240S] = f_wave(false, use240 and useShrt, kill240, c240, c720, c80, smi240, h240, m240, don240, cl240, ema240, h720, smi80, don80, rsi80, rma80, k80)

buyHit = hit240L or hit210L or hit180L or hit150L or hit120L or hit90L or hit60L or hit45L or hit30L or hit15L
sellHit = hit240S or hit210S or hit180S or hit150S or hit120S or hit90S or hit60S or hit45S or hit30S or hit15S
buyTag = hit240L ? "4س/80" : hit210L ? "210/70" : hit180L ? "3س/1س" : hit150L ? "150/50" : hit120L ? "2س/2س" : hit90L ? "90/30" : hit60L ? "1س/20" : hit45L ? "45/15" : hit30L ? "30/10" : "15/5"
sellTag = hit240S ? "4س/80" : hit210S ? "210/70" : hit180S ? "3س/1س" : hit150S ? "150/50" : hit120S ? "2س/2س" : hit90S ? "90/30" : hit60S ? "1س/20" : hit45S ? "45/15" : hit30S ? "30/10" : "15/5"
buyId = hit240L ? "240" : hit210L ? "210" : hit180L ? "180" : hit150L ? "150" : hit120L ? "120" : hit90L ? "90" : hit60L ? "60" : hit45L ? "45" : hit30L ? "30" : "15"
sellId = hit240S ? "240" : hit210S ? "210" : hit180S ? "180" : hit150S ? "150" : hit120S ? "120" : hit90S ? "90" : hit60S ? "60" : hit45S ? "45" : hit30S ? "30" : "15"

var string liveId = ""
var float longStop = na
var float longLim = na
var float shortStop = na
var float shortLim = na

killLive = (liveId == "15" and kill15) or (liveId == "30" and kill30) or (liveId == "45" and kill45) or (liveId == "60" and kill60) or (liveId == "90" and kill90) or (liveId == "120" and kill120) or (liveId == "150" and kill150) or (liveId == "180" and kill180) or (liveId == "210" and kill210) or (liveId == "240" and kill240)

if killLive
    if strategy.position_size > 0
        strategy.close("Long", comment="إلغاء ← إغلاق أكبر")
    if strategy.position_size < 0
        strategy.close("Short", comment="إلغاء ← إغلاق أكبر")
    liveId := ""

if buyHit
    if exitOpp and strategy.position_size < 0
        strategy.close("Short", comment="عكس")
    if strategy.position_size <= 0
        strategy.entry("Long", strategy.long, comment="شراء " + buyTag)
        longStop := close * (1.0 - slPct / 100.0)
        longLim  := close * (1.0 + tpPct / 100.0)
        liveId := buyId

if sellHit
    if exitOpp and strategy.position_size > 0
        strategy.close("Long", comment="عكس")
    if strategy.position_size >= 0
        strategy.entry("Short", strategy.short, comment="بيع " + sellTag)
        shortStop := close * (1.0 + slPct / 100.0)
        shortLim  := close * (1.0 - tpPct / 100.0)
        liveId := sellId

if usePct and strategy.position_size > 0
    strategy.exit("L-Exit", from_entry="Long", stop=longStop, limit=longLim)
if usePct and strategy.position_size < 0
    strategy.exit("S-Exit", from_entry="Short", stop=shortStop, limit=shortLim)

if strategy.position_size == 0 and not buyHit and not sellHit
    liveId := ""

f_seq(bool a, bool b, bool c, bool d, bool e, bool f, bool g, bool h, bool i) =>
    (a ? "1" : "-") + (b ? "2" : "-") + (c ? "3" : "-") + (d ? "4" : "-") + (e ? "5" : "-") + (f ? "6" : "-") + (g ? "7" : "-") + (h ? "8" : "-") + (i ? "9" : "-")

if showLbl
    if hit15L
        label.new(bar_index, low, "شراء 15/5", style=label.style_label_up, color=color.green, textcolor=color.white, size=size.tiny)
