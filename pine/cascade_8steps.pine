[dL81, h81, rL81, rS81, rsi81] = f_req_confirm("81")
[smi90, dL90, dC90, h90, mL90, mS90, eL90, eS90, rL90, rS90, bL90, bS90, rsi90] = f_req_htf("90")
[smi120, dC120, mL120, mS120, eL120, eS120, bL120, bS120, rsi120] = f_req_base("120")
