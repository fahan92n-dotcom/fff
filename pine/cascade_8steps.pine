[dC50, s8L50, s8S50] = f_req_entry("50")
[dL54, h54, rL54, rS54, rsi54] = f_req_confirm("54")
[smi60, dC60, mL60, mS60, eL60, eS60, bL60, bS60, rsi60] = f_req_base("60")
[dL63, h63, rL63, rS63, rsi63] = f_req_confirm("63")
[dC70, s8L70, s8S70] = f_req_entry("70")
